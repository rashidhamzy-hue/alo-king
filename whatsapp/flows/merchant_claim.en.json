  "screens": [
    {
      "id": "PROFILE",
      "title": "Your business",
      "data": {
        "name_ar": {
          "type": "string",
          "__example__": "فرن الضيعة"
        },
        "name_en": {
          "type": "string",
          "__example__": "Furn el Day3a"
        },
        "vendor_id": {
          "type": "string",
          "__example__": "00000000-0000-0000-0000-000000000000"
        },
        "opens": {
          "type": "string",
          "__example__": "09:00"
        },
        "closes": {
          "type": "string",
          "__example__": "23:00"
        },
        "radius_km": {
          "type": "string",
          "__example__": "5"
        },
        "cash": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "__example__": [
            "USD",
            "LBP"
          ]
        },
        "closed_days": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "__example__": []
        },
        "fee_note": {
          "type": "string",
          "__example__": "Delivery fee: $2 up to 3 km"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextCaption",
            "text": "You can change everything later from the dashboard or on WhatsApp."
          },
          {
            "type": "TextInput",
            "name": "name_ar",
            "label": "Name in Arabic",
            "input-type": "text",
            "required": true,
            "init-value": "${data.name_ar}",
            "max-chars": 80
          },
          {
            "type": "TextInput",
            "name": "name_en",
            "label": "Name in English",
            "input-type": "text",
            "required": false,
            "init-value": "${data.name_en}",
            "max-chars": 80
          },
          {
            "type": "TextInput",
            "name": "owner_name",
            "label": "Owner name",
            "input-type": "text",
            "required": true,
            "max-chars": 80
          },
          {
            "type": "Footer",
            "label": "Next",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "TERMS"
              },
              "payload": {
                "vendor_id": "${data.vendor_id}",
                "name_ar": "${form.name_ar}",
                "name_en": "${form.name_en}",
                "owner_name": "${form.owner_name}",
                "opens": "${data.opens}",
                "closes": "${data.closes}",
                "radius_km": "${data.radius_km}",
                "cash": "${data.cash}",
                "closed_days": "${data.closed_days}",
                "fee_note": "${data.fee_note}"
              }
            }
          }
        ]
      }
    },
