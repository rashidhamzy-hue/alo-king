{
  "version": "7.3",
  "routing_model": {
    "ADDRESS": []
  },
  "screens": [
    {
      "id": "ADDRESS",
      "title": "تفاصيل العنوان",
      "terminal": true,
      "data": {
        "address_id": {
          "type": "string",
          "__example__": "00000000-0000-0000-0000-000000000000"
        },
        "place_name": {
          "type": "string",
          "__example__": "Baakline"
        },
        "landmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "l1",
              "title": "Baakline municipality"
            },
            {
              "id": "none",
              "title": "Not listed"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextSubheading",
            "text": "${data.place_name}"
          },
          {
            "type": "TextCaption",
            "text": "منستعملها بس لتوصيل طلبك. الموقع من الـ pin اللي بعتّو."
          },
          {
            "type": "TextInput",
            "name": "building",
            "label": "اسم البناية",
            "input-type": "text",
            "required": true,
            "max-chars": 120
          },
          {
            "type": "TextInput",
            "name": "floor",
            "label": "الطابق",
            "input-type": "text",
            "required": false,
            "max-chars": 20
          },
          {
            "type": "RadioButtonsGroup",
            "name": "has_elevator",
            "label": "في مصعد شغّال؟",
            "required": false,
            "data-source": [
              {
                "id": "yes",
                "title": "إيه، في مصعد"
              },
              {
                "id": "no",
                "title": "ما في مصعد"
              }
            ]
          },
          {
            "type": "TextInput",
            "name": "apartment",
            "label": "الشقة",
            "input-type": "text",
            "required": false,
            "max-chars": 20
          },
          {
            "type": "Dropdown",
            "name": "landmark_id",
            "label": "أقرب معلم",
            "required": false,
            "data-source": "${data.landmarks}"
          },
          {
            "type": "Dropdown",
            "name": "landmark_relation",
            "label": "بالنسبة للمعلم",
            "required": false,
            "data-source": [
              {
                "id": "at",
                "title": "عندو"
              },
              {
                "id": "next_to",
                "title": "حدّو"
              },
              {
                "id": "opposite",
                "title": "مقابيلو"
              },
              {
                "id": "behind",
                "title": "وراه"
              },
              {
                "id": "above",
                "title": "فوقو"
              },
              {
                "id": "below",
                "title": "تحتو"
              },
              {
                "id": "near",
                "title": "قريب منو"
              },
              {
                "id": "after",
                "title": "بعدو"
              },
              {
                "id": "before",
                "title": "قبلو"
              }
            ]
          },
          {
            "type": "TextInput",
            "name": "landmark",
            "label": "معلم تاني",
            "input-type": "text",
            "required": false,
            "max-chars": 120
          },
          {
            "type": "TextInput",
            "name": "driver_phone",
            "label": "رقم للسائق",
            "input-type": "phone",
            "required": false
          },
          {
            "type": "TextArea",
            "name": "notes",
            "label": "ملاحظات للسائق",
            "required": false,
            "max-length": 300
          },
          {
            "type": "Footer",
            "label": "احفظ العنوان",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "address_id": "${data.address_id}",
                "building": "${form.building}",
                "floor": "${form.floor}",
                "has_elevator": "${form.has_elevator}",
                "apartment": "${form.apartment}",
                "landmark_id": "${form.landmark_id}",
                "landmark_relation": "${form.landmark_relation}",
                "landmark": "${form.landmark}",
                "driver_phone": "${form.driver_phone}",
                "notes": "${form.notes}"
              }
            }
          }
        ]
      }
    }
  ]
}
