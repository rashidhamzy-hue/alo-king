{
  "version": "7.3",
  "routing_model": {
    "ADDRESS": []
  },
  "screens": [
    {
      "id": "ADDRESS",
      "title": "تفاصيل العنوان",
      "terminal": true,
      "data": {
        "address_id": {
          "type": "string",
          "__example__": "00000000-0000-0000-0000-000000000000"
        },
        "place_name": {
          "type": "string",
          "__example__": "Baakline"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextSubheading",
            "text": "${data.place_name}"
          },
          {
            "type": "TextCaption",
            "text": "منستعملها بس لنوصلك الطلب. الموقع (Location) بيبقى من الدبوس اللي بعتّو."
          },
          {
            "type": "TextInput",
            "name": "building",
            "label": "اسم البناية",
            "input-type": "text",
            "required": true,
            "max-chars": 120
          },
          {
            "type": "TextInput",
            "name": "floor",
            "label": "الطابق",
            "input-type": "text",
            "required": false,
            "max-chars": 20
          },
          {
            "type": "TextInput",
            "name": "apartment",
            "label": "رقم الشقة",
            "input-type": "text",
            "required": false,
            "max-chars": 20
          },
          {
            "type": "TextInput",
            "name": "landmark",
            "label": "معلم قريب",
            "input-type": "text",
            "required": false,
            "max-chars": 120
          },
          {
            "type": "TextInput",
            "name": "driver_phone",
            "label": "رقم للسائق",
            "input-type": "phone",
            "required": false
          },
          {
            "type": "TextArea",
            "name": "notes",
            "label": "ملاحظات للسائق",
            "required": false,
            "max-length": 300
          },
          {
            "type": "Footer",
            "label": "حفظ العنوان",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "address_id": "${data.address_id}",
                "building": "${form.building}",
                "floor": "${form.floor}",
                "apartment": "${form.apartment}",
                "landmark": "${form.landmark}",
                "driver_phone": "${form.driver_phone}",
                "notes": "${form.notes}"
              }
            }
          }
        ]
      }
    }
  ]
}
