        },
        "lines_text": {
          "type": "string",
          "__example__": "2× Chicken Shawarma · **$10.00**"
        },
        "remove_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "alt-text": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "l1",
              "title": "2× Chicken Shawarma"
            }
          ]
        },
        "has_lines": {
          "type": "boolean",
          "__example__": true
        },
        "totals_text": {
          "type": "string",
          "__example__": "Subtotal: $10.00\nDelivery: $2.00\n**Total: $12.00 · 1,074,000 LBP**"
        },
        "confirm_note": {
          "type": "string",
          "__example__": "Confirm sends the summary to the chat."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextSubheading",
            "text": "${data.shop}"
          },
          {
            "type": "TextBody",
            "text": "${data.lines_text}",
            "markdown": true
          },
