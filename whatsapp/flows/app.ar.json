            "required": false
          },
          {
            "type": "TextBody",
            "text": "${data.totals_text}",
            "markdown": true
          },
          {
            "type": "TextCaption",
            "text": "${data.confirm_note}"
          },
          {
            "type": "Footer",
            "label": "تأكيد",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "go": "confirm",
                "remove": "${form.remove}"
              }
            }
          }
        ]
      }
