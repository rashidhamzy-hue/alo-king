---
// The frame of every page. WEB4a: the founder's design reference's header, footer and phone bottom bar (components/ref/Frame.tsx, React
// rendered here on the server: no React reaches the browser), from the database: the served villages, the visitor's village, the basket's
// count and items total, the hours, the chat's address (lib/frame.ts). `whatsapp` is the chat's address a page already read; with none
// anywhere, no WhatsApp button is shown. `focus` (the checkout; an order waiting for its WhatsApp tap): one primary action per screen, so
// the basket, the WhatsApp order button, the village chip and the bottom bar are not drawn. `bare`: the page draws its own width (home).
// `frame`: the page already read the frame (home, for its hero). `jsonld`: schema.org objects (LD1), data blocks, not scripts.
// `basket` is the basket's count on a page that knows it; `noindex` keeps a person's pages out of search engines; `refresh` (seconds) makes
// a page that waits for WhatsApp follow it with no script.
import "../styles/site.css";
import "../styles/ref.css";
import Icon from "@ak/ui-astro/Icon.astro";
import { Header, Footer, BottomNav, type FrameData } from "../components/ref/Frame";
import arabic400 from "../../../../packages/ui/fonts/plex-arabic-400.woff2?url";
import latin400 from "../../../../packages/ui/fonts/plex-latin-400.woff2?url";
import { dirOf, t, type Lang } from "../lib/i18n";
import { jsonLdScript } from "../lib/jsonld";
import { frameOf } from "../lib/frame";
interface Props { title: string; lang: Lang; description?: string; q?: string; path?: string; whatsapp?: string | null; live?: boolean; jsonld?: unknown[];
  basket?: number | null; noindex?: boolean; refresh?: number | null; focus?: boolean; bare?: boolean; frame?: FrameData }
const { title, lang, description, q = "", path = "/", whatsapp = null, live = false, jsonld = [], basket = null, noindex = false, refresh = null,
  focus = false, bare = false } = Astro.props;
// WEB2: "Added to your basket", after an add from a card with no script (/cart/line sends the visitor back with ?added=<sku>).
const added = /^AK-\d{1,8}$/.test(Astro.url.searchParams.get("added") ?? "");
const full = title === t(lang, "site") ? title : `${title} · ${t(lang, "site")}`;
const f: FrameData = Astro.props.frame ?? await frameOf(Astro.locals.env, Astro.request.headers.get("cookie"), { lang, path, q, live, focus, basketCount: basket });
if (!f.chat && whatsapp) f.chat = whatsapp.replace(/\?.*$/, "") || null;
f.focus = focus;
---
<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{full}</title>
  {description && <meta name="description" content={description}>}
  <meta name="theme-color" content="#0E0F12">
  {noindex && <meta name="robots" content="noindex">}
  {refresh && <meta http-equiv="refresh" content={String(refresh)}>}
  <link rel="preload" href={lang === "ar" ? arabic400 : latin400} as="font" type="font/woff2" crossorigin>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  {jsonld.map((j) => <script type="application/ld+json" set:html={jsonLdScript(j)} />)}
</head>
<body class="ref">
  <a class="skip" href="#main">{t(lang, "skip")}</a>
  <Header f={f} />
  <main id="main" class={bare ? "bare" : "wrap"}>
    {added && <p class="added" role="status"><Icon name="check" /><span>{t(lang, "w2_added")}</span> <a href="/cart">{t(lang, "w2_view_basket")}</a></p>}
    {Astro.url.searchParams.get("v") === "set" && f.village && <p class="added" role="status"><Icon name="pin" /><span>{t(lang, "w4_village_set", { village: f.village.name })}</span></p>}
    <slot />
  </main>
  <Footer f={f} />
  <BottomNav f={f} />
  <script src="/sw-register.js" defer></script>
  <script src="/site.js" defer></script>
</body>
</html>
