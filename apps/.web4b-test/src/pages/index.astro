---
// Home. WEB4a: the founder's design reference's home page (components/ref/Home.tsx), rendered on the server from the database: the hours,
// the served villages with fee and time, the visitor's village (frame), the categories with their counts (web_catalog_home), the product
// rails, "most ordered" once there are 30 days of orders, and the Ask strip's switch (web_home_extras, 0243). Works with no script.
import Base from "../layouts/Base.astro";
import Unavailable from "../components/Unavailable.astro";
import AddForm from "../components/AddForm.astro";
import { Home, type HomeData } from "../components/ref/Home";
import { nameIn, t } from "../lib/i18n";
import { toCard } from "../lib/cards";
import { frameOf } from "../lib/frame";
import { CATEGORY_PHOTOS, toneOf } from "../lib/category-photos";
const { lang, catalog, env } = Astro.locals;
let d: HomeData | null = null; let failed = false; let whatsapp: string | null = null;
// The rails drawn, in this order, when the category has items (a look choice, as the reference's: the rest are one tap away in the aisles).
const RAILS = ["dairy_eggs", "bakery", "fruits_vegetables", "pantry_staples"];
try {
  const [home, extras, f] = await Promise.all([catalog().home(), catalog().homeExtras(12), frameOf(env, Astro.request.headers.get("cookie"), { lang, path: "/" })]);
  whatsapp = home.whatsapp.home;
  if (!f.chat && whatsapp) f.chat = whatsapp.replace(/\?.*$/, "") || null;
  const card = (code: string) => (c: Parameters<typeof toCard>[2]) => toCard(lang, env, c, code);
  const rails = RAILS.map((code) => extras.rails.find((r) => r.code === code)).filter((r): r is NonNullable<typeof r> => !!r)
    .map((r) => ({ code: r.code, name: nameIn(lang, r.name_en, r.name_ar), items: r.items.map(card(r.code)) }));
  d = {
    f,
    categories: home.categories.map((c) => ({ code: c.code, name: nameIn(lang, c.name_en, c.name_ar), count: c.count, tone: toneOf(c.code), fresh: !!CATEGORY_PHOTOS[c.code]?.fresh })),
    rails,
    most: extras.most_ordered ? extras.most_ordered.map(card("")) : null,
    ask: !!extras.ask,
    itemsTotal: home.categories.reduce((a, c) => a + c.count, 0),
  };
} catch { failed = true; Astro.response.status = 503; }
---
<Base title={t(lang, "site")} lang={lang} description={t(lang, "w4_hero_text")} path="/" whatsapp={whatsapp} frame={d?.f} bare={!!d}>
  {failed || !d ? <Unavailable lang={lang} /> : <div itemscope itemtype="https://schema.org/GroceryStore">
    <meta itemprop="url" content={Astro.url.origin}>
    <meta itemprop="name" content={t(lang, "site")}>
    {d.f.hours && <meta itemprop="openingHours" content={`Mo-Su ${d.f.hours.replace("–", "-")}`}>}
    <meta itemprop="paymentAccepted" content="Cash">
    {d.f.villages.map((v) => <meta itemprop="areaServed" content={v.name}>)}
    <AddForm />
    <Home d={d} />
    {env.ENVIRONMENT !== "production" && <p class="small wrap"><a href="/gallery">{t(lang, "gallery")}</a></p>}
  </div>}
</Base>
