---
// Search. WEB4a stage 2: the reference's layout (components/ref/Shop.tsx, SearchBar and SearchResults): a sticky box, the results as cards
// with chips by aisle (links: they work with no script), and when nothing is found the honest "we do not have it yet" (logged as demand by the
// database) with the chat, then the aisles. SR1 holds: the box is read as the chat reads a message (readSearch) and the chat's own matcher
// answers (web_catalog_search). With scripts on, the results follow the typing: public/site.js asks this page and swaps [data-live].
import Base from "../layouts/Base.astro";
import Unavailable from "../components/Unavailable.astro";
import AddForm from "../components/AddForm.astro";
import { SearchBar, SearchResults, type AisleLink, type SearchView } from "../components/ref/Shop";
import { nameIn, t, withGreeting } from "../lib/i18n";
import { readSearch } from "@ak/search/reading";
import { toCard } from "../lib/cards";
import { CATEGORY_PHOTOS, toneOf } from "../lib/category-photos";
const { lang, catalog, env } = Astro.locals;
const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 80);
let r; let failed = false; let ask: string | null = null; let aisles: AisleLink[] = [];
try {
  const homeP = catalog().home();
  if (q.length >= 2) {
    // SR1: "snacks with no sugar" searches "snacks" with the filter, so only items whose approved facts pass come back.
    const reading = readSearch(q);
    r = await catalog().search(reading.query || q, 12, reading.filters as Record<string, unknown>);
  }
  try { const h = await homeP; ask = h.whatsapp.home;
    aisles = h.categories.map((c) => ({ code: c.code, name: nameIn(lang, c.name_en, c.name_ar), count: c.count, tone: toneOf(c.code), fresh: !!CATEGORY_PHOTOS[c.code]?.fresh })); } catch { /* the page is complete without it */ }
} catch { failed = true; Astro.response.status = 503; }
Astro.response.headers.set("Cache-Control", "no-store");
const found = r?.matches ?? [];
const cat = Astro.url.searchParams.get("cat") ?? "";
const codes = [...new Set(found.map((i) => i.category_code).filter((c): c is string => !!c))];
const pick = codes.includes(cat) ? cat : "";
const shown = pick ? found.filter((i) => i.category_code === pick) : found;
const qs = (c: string) => `/search?q=${encodeURIComponent(q)}${c ? `&cat=${encodeURIComponent(c)}` : ""}`;
const view: SearchView = {
  lang, q, state: q.length === 0 ? "empty" : q.length < 2 ? "short" : found.length ? "found" : "none",
  results: shown.map((c) => toCard(lang, env, c)),
  resultsText: t(lang, "search_found", { n: found.length }),
  facets: codes.length > 1 ? [{ label: t(lang, "w4_all"), href: qs(""), current: !pick },
    ...codes.map((c) => ({ label: aisles.find((a) => a.code === c)?.name ?? c, href: qs(c), current: pick === c }))] : [],
  none: r && found.length === 0 ? t(lang, "search_none", { q }) : null,
  ask: withGreeting(ask, lang), aisles, credit: found.some((i) => i.picture?.licence === "cc_by_sa") ? t(lang, "credit_pictures") : null,
};
---
<Base title={q ? t(lang, "search_results", { q }) : t(lang, "search")} lang={lang} q={q} path={`/search?q=${encodeURIComponent(q)}`} whatsapp={ask} bare={!failed}>
  {failed ? <Unavailable lang={lang} /> : <>
    <AddForm />
    <SearchBar lang={lang} q={q} />
    <div data-live aria-live="polite"><SearchResults v={view} /></div>
  </>}
</Base>
