---
// WEB4b: one place's menu, for a visitor who may order from it (FD2's web_food_menu, 0251/0252): its dishes by section, the database's
// prices, each dish's choices. A required choice is answered before "Add" (a required radio; /food/basket/add checks again). Each dish's
// food facts are "declared by the place" or "not confirmed yet: ask us" (invariant 15). A place this visitor may not order from (a
// testers-only place and a visitor who is not a tester, an unknown id) is "not found": the page never says such a place exists.
// Never cached: who sees a testers-only place is decided by the visitor's own session.
import Base from "../../../layouts/Base.astro";
import Unavailable from "../../../components/Unavailable.astro";
import { MenuPage, type DishView, type MenuView } from "../../../components/ref/Food";
import { nameIn, t } from "../../../lib/i18n";
import { FACT_CODES } from "../../../lib/i18n-web4b";
import { foodApi, orderHref } from "../../../lib/food";
import { basketOf, dishCount, isUuid } from "../../../lib/food-basket";
import { ordering, visitorOf, chatWith } from "../../../lib/order";
import { openWords } from "../../../lib/food-words";
const { lang, env } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");
const cookie = Astro.request.headers.get("cookie");
const id = String(Astro.params.id ?? "");
let failed = false; let menu: any = null; let place: any = null; let chat: string | null = null;
try {
  if (isUuid(id)) {
    const v = await visitorOf(env, cookie);
    const api = foodApi(env);
    const [m, places, facts] = await Promise.all([api.menu(v.token, id), api.places(v.token), ordering(env).serviceFacts().catch(() => null)]);
    if (m.ok) { menu = m; place = places.find((p) => p.source_id === id) ?? null; }
    chat = facts?.whatsapp ?? null;
  }
} catch { failed = true; Astro.response.status = 503; }
if (!failed && !menu) Astro.response.status = 404;

let view: MenuView | null = null;
if (menu) {
  const basket = basketOf(cookie);
  const count = dishCount(basket);
  const need = Astro.url.searchParams.get("need");
  const needGroup = Astro.url.searchParams.get("g");
  const dishes: DishView[] = (menu.dishes ?? []).map((d: any): DishView => {
    const declared = (d.facts ?? []).filter((f: any) => f.status === "declared_by_vendor");
    const word = (code: string) => (FACT_CODES as readonly string[]).includes(code) ? t(lang, `w4b_fact_${code}`) : code;
    const valueWord = (v: string | null) => { const k = `w4b_v_${String(v ?? "").toLowerCase()}`; return t(lang, k) !== k ? t(lang, k) : String(v ?? ""); };
    return {
      id: d.product_id, name: nameIn(lang, d.name_en, d.name_ar),
      altName: lang === "ar" ? (d.name_en && d.name_ar ? { text: d.name_en, lang: "en" } : null) : (d.name_ar ? { text: d.name_ar, lang: "ar" } : null),
      price: Number(d.price_usd),
      groups: (d.groups ?? []).map((g: any) => ({
        id: g.group_id, name: nameIn(lang, g.name_en, g.name_ar), required: !!g.required, multi: Number(g.max) > 1,
        hint: Number(g.max) > 1 ? (Number(g.min) > 0 ? t(lang, "w4b_pick_range", { min: Math.max(1, Number(g.min)), max: Number(g.max) }) : t(lang, "w4b_pick_up_to", { n: Number(g.max) })) : t(lang, "w4b_pick_one"),
        options: (g.options ?? []).map((o: any) => ({ id: o.id, name: nameIn(lang, o.name_en, o.name_ar), delta: Number(o.price_delta_usd) })),
      })),
      facts: {
        declared: declared.map((f: any) => ({ name: word(f.attribute), declared: valueWord(f.value) })),
        notConfirmed: (d.facts ?? []).filter((f: any) => f.status !== "declared_by_vendor").map((f: any) => word(f.attribute)),
      },
    };
  });
  // sections in the menu's order, named in the page's language (0252 gives both names; the stored one otherwise)
  const sections: MenuView["sections"] = [];
  for (const [i, d] of (menu.dishes ?? []).entries()) {
    const title = (lang === "ar" ? d.section_ar || d.section_en : d.section_en || d.section_ar) || d.section || null;
    let s = sections.find((x) => x.title === title);
    if (!s) { s = { id: `s${sections.length + 1}`, title, dishes: [] }; sections.push(s); }
    s.dishes.push(dishes[i]!);
  }
  const needDish = need && isUuid(need) ? dishes.find((d) => d.id === need) ?? null : null;
  const g = needDish?.groups.find((x) => x.id === needGroup) ?? null;
  const open = openWords(lang, menu.open ?? place?.open ?? null);
  view = {
    lang, placeId: id, name: menu.name ?? place?.name ?? "", village: place ? nameIn(lang, place.village_en, place.village_ar) || null : null,
    prep: t(lang, "w4b_prep", { n: Number(menu.prep_minutes ?? place?.prep_minutes ?? 0) }), status: open.text, open: open.open,
    sections,
    need: needDish ? { dish: needDish.id, text: g ? t(lang, "w4b_need_choice", { group: g.name }) : t(lang, "w4b_bad_choice") } : null,
    notice: Astro.url.searchParams.get("added") === "1" ? t(lang, "w4b_added") : null,
    basket: count > 0 ? { count, here: basket!.place === id, label: t(lang, "w4b_view_basket", { n: count }) } : null,
    back: orderHref(id), ask: chatWith(chat, `${menu.name ?? ""}: `),
  };
}
---
<Base title={view ? view.name : t(lang, "not_found")} lang={lang} path={Astro.url.pathname} whatsapp={chat} noindex bare={!!view}>
  {failed ? <Unavailable lang={lang} /> : !view ? <Unavailable lang={lang} notFound /> : <MenuPage v={view} />}
</Base>
