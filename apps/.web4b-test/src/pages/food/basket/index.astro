---
// WEB4b: the food basket. One place's dishes (kept apart from the grocery basket), each priced again by the database on every view
// (web_food_quote, 0251: the dish and its chosen options, the service fee from settings, the delivery fee and the estimate once we know
// where), never by the page (invariant 7). What stops the order (a closed place, a choice still to make, a dish gone, the minimum) is said
// in words, and then there is no way to checkout. Works with no script. Never cached.
import Base from "../../../layouts/Base.astro";
import Unavailable from "../../../components/Unavailable.astro";
import { BasketPage, type BasketView } from "../../../components/ref/Food";
import { t } from "../../../lib/i18n";
import { foodApi, orderHref } from "../../../lib/food";
import { basketCookie, basketOf, type FoodBasket } from "../../../lib/food-basket";
import { NOT_THE_BASKETS, issueWords } from "../../../lib/food-words";
import { ordering, visitorOf } from "../../../lib/order";
import { pricedLines } from "../../../lib/food-quote";
const { lang, env } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");
const cookie = Astro.request.headers.get("cookie");
let failed = false; let view: BasketView | null = null; let chat: string | null = null;
try {
  let basket: FoodBasket | null = basketOf(cookie);
  const v = await visitorOf(env, cookie);
  const api = foodApi(env);
  chat = (await ordering(env).serviceFacts().catch(() => null))?.whatsapp ?? null;
  let menu: any = null; let q: any = null;
  if (basket) {
    menu = await api.menu(v.token, basket.place);
    // a place this visitor may not order from (any more), or a dish that is not that place's: the basket is gone, said once
    if (!menu.ok) { basket = null; Astro.response.headers.append("Set-Cookie", basketCookie(null)); }
  }
  if (basket) {
    // a signed-in visitor's saved place gives the fee and the estimate here already; the checkout chooses the place
    let at: string | null = null;
    if (v.linked && v.token) { const acc = await ordering(env).account(v.token); at = acc?.ok ? acc.places?.[0]?.place_id ?? null : null; }
    q = await api.quote(v.token, basket.place, basket.lines, at);
    if (!q.ok) { basket = null; Astro.response.headers.append("Set-Cookie", basketCookie(null)); }
  }
  const quote = q?.quote ?? null;
  const lines = basket ? pricedLines(lang, basket, menu, quote) : [];
  const dishName = (id: string) => lines.find((x) => x.productId === id)?.name ?? null;
  const issues = (quote?.issues ?? []).filter((i: any) => !NOT_THE_BASKETS.has(i.code)).map((i: any) => issueWords(lang, i, dishName));
  const known = !!quote && !(quote.issues ?? []).some((i: any) => i.code === "no_delivery_village" || i.code === "village_not_served");
  const sums: BasketView["sums"] = [];
  if (quote) {
    sums.push({ label: t(lang, "w4b_dishes"), amount: Number(quote.subtotal_usd) });
    if (Number(quote.service_fee_usd ?? 0) > 0) sums.push({ label: t(lang, "w4b_service_fee"), amount: Number(quote.service_fee_usd) });
    if (known) sums.push({ label: t(lang, "w4b_delivery"), amount: Number(quote.delivery_fee_usd ?? 0) });
  }
  view = {
    lang, place: basket && menu?.ok ? { name: menu.name, href: orderHref(basket.place) } : null, lines,
    sums, total: known ? Number(quote.total_usd) : null, eta: known && quote?.eta_minutes ? t(lang, "w4b_eta", { n: quote.eta_minutes }) : null,
    feeLater: !!quote && !known, issues, canCheckout: lines.length > 0 && issues.length === 0,
    notice: Astro.url.searchParams.get("full") === "1" ? t(lang, "w4b_full") : null,
  };
} catch { failed = true; Astro.response.status = 503; }
---
<Base title={t(lang, "w4b_basket_title")} lang={lang} path="/food/basket" whatsapp={chat} noindex bare={!!view}>
  {failed || !view ? <Unavailable lang={lang} /> : <BasketPage v={view} />}
</Base>
