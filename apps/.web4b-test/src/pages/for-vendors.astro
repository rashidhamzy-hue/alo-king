---
// Sell on Alo King (session UX3; the founder's reference, "for-vendors", with our real rules). What Alo King offers a kitchen or a shop, with no commission figure
// published (the commission is part of the terms agreed before anyone starts), and an application: the place's name, its kind, its village and the owner's WhatsApp,
// confirmed the WEB2 way (a code sent to us first: invariant 17). If the place is one of LV1's listings (?place=<id>), the application links to it and counts as its
// claim. An application is a staff case and nothing else: it never makes a merchant or opens a place (invariant 11: approve_merchant is the only door).
import Base from "../layouts/Base.astro";
import Unavailable from "../components/Unavailable.astro";
import ConfirmNumber from "../components/ConfirmNumber.astro";
import Button from "@ak/ui-astro/Button.astro";
import Field from "@ak/ui-astro/Field.astro";
import Icon from "@ak/ui-astro/Icon.astro";
import { chatBase, t } from "../lib/i18n";
import { kindLabel, validListingId } from "../lib/food";
import { refusal, vendorApplication, vendorProblem, vendorValues, villageText, type VendorValues } from "../lib/join";
import { sameOrigin, tokenOf, withSession } from "../lib/session";
import type { JoinOptions, JoinState } from "@ak/commerce/index";
const { lang, join, listings, env } = Astro.locals;
const path = "/for-vendors";
const PURPOSE = "vendor" as const;
const req = Astro.request;
const cookie = req.headers.get("cookie");
let failed = false; let error = ""; let setCookie: string | null = null;
let values: VendorValues = { name: "", kind: "", village: "", listing: "" };
const back = (to: string, c: string | null) => { const h = new Headers({ Location: to, "Cache-Control": "no-store" }); if (c) h.append("Set-Cookie", c); return new Response(null, { status: 303, headers: h }); };

if (req.method === "POST") {
  if (!sameOrigin(req, Astro.url)) return new Response("Forbidden", { status: 403, headers: { "Content-Type": "text/plain; charset=utf-8" } });
  const form = await req.formData();
  const step = String(form.get("step") ?? "");
  try {
    if (step === "code") {
      const r = await withSession(env, cookie, (token) => join().code(token, PURPOSE));
      const place = Astro.url.searchParams.get("place") ?? "";
      return back(`${path}${validListingId(place) ? `?place=${encodeURIComponent(place)}` : ""}#confirm`, r.setCookie);
    }
    if (step === "apply") {
      values = vendorValues(form);
      const options = await join().options();
      const problem = vendorProblem(values, options);
      if (problem) { error = t(lang, problem); Astro.response.status = 400; }
      else {
        const r = await withSession(env, cookie, (token) => join().applyVendor(token, vendorApplication(values)));
        setCookie = r.setCookie;
        if (r.result.ok) return back(`${path}?applied=1`, r.setCookie);
        error = t(lang, refusal(r.result)); Astro.response.status = 400;
      }
    }
  } catch { failed = true; Astro.response.status = 503; }
}
if (setCookie) Astro.response.headers.append("Set-Cookie", setCookie);

let options: JoinOptions | null = null; let state: JoinState | null = null;
let place: { listing_id: string; name: string; kind: string; village: string | null } | null = null;
try {
  options = await join().options();
  const token = tokenOf(setCookie) ?? tokenOf(cookie);
  state = token ? await join().state(token, PURPOSE) : null;
  // A listed place the visitor came from (its own page's link): read as the Food page reads it. One that is hidden or unknown is simply not there.
  const wanted = (Astro.url.searchParams.get("place") ?? values.listing).trim();
  if (wanted && validListingId(wanted)) { const p = await listings().place(wanted); if (p.ok) place = p.listing; }
} catch { failed = true; Astro.response.status = 503; }
const o = options;
const linked = state?.valid === true && state.linked;
const applied = state?.application ?? null;
const chat = chatBase(o?.whatsapp);
// What the form starts with: what was typed (after a problem), else the listed place's own details.
const start = { name: values.name || place?.name || "", kind: values.kind || (place && o?.vendor_kinds.includes(place.kind) ? place.kind : ""), village: values.village || place?.village || "" };
const placePath = place ? `${path}?place=${encodeURIComponent(place.listing_id)}` : path;
---
<Base title={t(lang, "vend_eyebrow")} lang={lang} description={t(lang, "vend_lead")} path={Astro.url.pathname} whatsapp={chat}>
  {failed || !o ? <Unavailable lang={lang} /> : <div class="join">
    <section class="hero">
      <div>
        <p class="eyebrow">{t(lang, "vend_eyebrow")}</p>
        <h1>{t(lang, "vend_title")}</h1>
        <p>{t(lang, "vend_lead")}</p>
        <p class="state"><Icon name="alert" /> {t(lang, "vend_notopen")}</p>
        <div class="cta">
          <Button label={t(lang, "vend_cta")} href="#apply" variant="soft" size="lg" />
          <Button label={t(lang, "vend_listed")} href="/food" variant="soft" size="lg" />
        </div>
      </div>
    </section>

    <h2>{t(lang, "vend_offer_h")}</h2>
    <ul class="tiles">
      <li><Icon name="chat" /><h3>{t(lang, "vend_o1_t")}</h3><p>{t(lang, "vend_o1")}</p></li>
      <li><Icon name="bike" /><h3>{t(lang, "vend_o2_t")}</h3><p>{t(lang, "vend_o2")}</p></li>
      <li><Icon name="search" /><h3>{t(lang, "vend_o3_t")}</h3><p>{t(lang, "vend_o3")}</p></li>
      <li><Icon name="shield" /><h3>{t(lang, "vend_o4_t")}</h3><p>{t(lang, "vend_o4")}</p></li>
    </ul>

    <h2>{t(lang, "vend_next_h")}</h2>
    <ol class="ticks">
      <li><Icon name="chat" /><span>{t(lang, "vend_n1")}</span></li>
      <li><Icon name="message" /><span>{t(lang, "vend_n2")}</span></li>
      <li><Icon name="list" /><span>{t(lang, "vend_n3")}</span></li>
      <li><Icon name="store" /><span>{t(lang, "vend_n4")}</span></li>
    </ol>

    <h2 id="apply">{t(lang, "vend_apply_h")}</h2>
    {place && <section class="ak-card" aria-labelledby="place-h">
      <h3 id="place-h">{t(lang, "vend_place_h")}</h3>
      <p><strong>{place.name}</strong> · {kindLabel(lang, place.kind)}</p>
      <p>{t(lang, "vend_claim_note", { name: place.name })}</p>
      <p class="small"><a href={path}>{t(lang, "vend_claim_other")}</a></p>
    </section>}
    {applied
      ? <section class="ak-card" role="status"><h3><Icon name="check" /> {t(lang, "join_done_h")}</h3><p>{t(lang, "vend_done_text")}</p></section>
      : !linked
        ? <ConfirmNumber lang={lang} purpose={PURPOSE} path={placePath} code={state?.code_waiting?.code ?? null} chat={chat} error={error || undefined} />
        : <>
            <p class="confirmed"><Icon name="check" /> {t(lang, "join_confirmed")}</p>
            <form method="post" action={path} class="stack">
              <input type="hidden" name="step" value="apply">
              {place && <input type="hidden" name="listing" value={place.listing_id}>}
              {error && <p class="err" role="alert"><Icon name="alert" /> {error}</p>}
              <Field label={t(lang, "vend_name")}><input class="ak-input" name="name" value={start.name} required maxlength="80" autocomplete="organization"></Field>
              <Field label={t(lang, "vend_kind")}>
                <select class="ak-select" name="kind" required>
                  <option value="">{t(lang, "vend_kind_choose")}</option>
                  {o.vendor_kinds.map((k) => <option value={k} selected={k === start.kind}>{kindLabel(lang, k)}</option>)}
                </select>
              </Field>
              <Field label={t(lang, "vend_village")}>
                <input class="ak-input" name="village" value={start.village} list="join-villages" maxlength="60" autocomplete="off">
                <datalist id="join-villages">{o.villages.map((v) => <option value={villageText(lang, v)}></option>)}</datalist>
              </Field>
              <div class="actions"><Button label={t(lang, "vend_submit")} variant="primary" size="lg" icon="check" /></div>
            </form>
          </>}
  </div>}
</Base>
