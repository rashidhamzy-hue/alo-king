---
// One product. WEB4a stage 2: the reference's layout (components/ref/Shop.tsx, ProductPage and ProductFacts): back to its aisle, the picture
// (or its aisle's icon), brand, name, the price and what it is for (0244), the one primary action "Add to basket", the delivery line, the facts
// in folded sections, more from the aisle. LD1 holds: only the fields of the item's own template, "not confirmed yet" for a field not
// approved (invariant 15), the page and its JSON-LD built from the same read and view (lib/product.ts), so they cannot disagree. SELL1:
// "coming soon" has no Add. Asking on WhatsApp is a plain link (one primary action per page).
import Base from "../../layouts/Base.astro";
import Unavailable from "../../components/Unavailable.astro";
import AddForm from "../../components/AddForm.astro";
import { ProductPage, type ProductPageView } from "../../components/ref/Shop";
import { nameIn, t, unitLabel } from "../../lib/i18n";
import { pictureUrl } from "../../lib/db";
import { productView } from "../../lib/product";
import { productJsonLd } from "../../lib/jsonld";
import { frameOf } from "../../lib/frame";
import { priceForText, toCard } from "../../lib/cards";
import { toneOf } from "../../lib/category-photos";
const { lang, catalog, env } = Astro.locals;
let r; let failed = false; let more: ReturnType<typeof toCard>[] = [];
const sku = String(Astro.params.sku ?? "");
try { r = /^[a-z0-9_-]{1,40}$/i.test(sku) ? await catalog().product(sku) : { ok: false as const, error: "unknown_product" as const }; } catch { failed = true; Astro.response.status = 503; }
if (r && !r.ok) Astro.response.status = 404;
const ok = r && r.ok ? r : null;
const view = ok ? productView(lang, ok) : null;
const name = view ? view.name : t(lang, "not_found");
const pic = ok?.picture ?? null;
const imageUrl = pic ? pictureUrl(env, pic.path, 1200) : null;
const ask = ok?.whatsapp ? ok.whatsapp.replaceAll("{sku}", encodeURIComponent(ok.product.sku)) : null;
const jsonld = ok && view ? [productJsonLd(lang, ok, { origin: Astro.url.origin, imageUrl }, view)] : [];
let f = null;
if (ok && view) {
  const [frame, aisle] = await Promise.all([
    frameOf(env, Astro.request.headers.get("cookie"), { lang, path: Astro.url.pathname }),
    catalog().category(ok.category.code).catch(() => null),
  ]);
  f = frame;
  if (aisle?.ok) more = aisle.sections.flatMap((s) => s.items).filter((c) => c.sku !== ok.product.sku && c.in_stock).slice(0, 12).map((c) => toCard(lang, env, c, ok.category.code));
}
const per = ok ? priceForText(lang, ok.product.price_for) : null;
const unit = ok && !ok.product.price_for ? unitLabel(lang, ok.product.sell_unit) : "";
const pv: ProductPageView | null = ok && view && f ? {
  f, sku: ok.product.sku, name, altName: view.altName, brand: view.brand,
  aisle: { code: ok.category.code, name: nameIn(lang, ok.category.name_en, ok.category.name_ar) },
  card: { ...toCard(lang, env, { ...ok.product, picture: null, category_code: ok.category.code } as any, ok.category.code), tone: toneOf(ok.category.code) },
  picture: pic && imageUrl ? { src: imageUrl, width: pic.width_px ?? 1200, height: pic.height_px ?? 1200, credit: pic.attribution ?? null } : null,
  chips: [view.size, unit, view.gtin ? `${t(lang, "barcode")}: ${view.gtin}` : null].filter((x): x is string => !!x),
  priced: view.priced, price: view.price, per, status: view.comingSoon ? "soon" : view.inStock ? "in" : "out",
  canAdd: view.inStock && !view.comingSoon && view.priced, addBack: Astro.url.pathname, ask: ask && !view.comingSoon ? ask : null,
  view, creditOff: !!ok.credit_open_food_facts, more,
} : null;
---
<Base title={name} lang={lang} path={Astro.url.pathname} whatsapp={ok?.whatsapp ? ok.whatsapp.replace(/\?.*$/, "") : null} jsonld={jsonld} frame={f ?? undefined} bare={!!pv}>
  {failed ? <Unavailable lang={lang} /> : !pv || !view ? <Unavailable lang={lang} notFound /> : <>
    <AddForm />
    <ProductPage v={pv} />
  </>}
</Base>
