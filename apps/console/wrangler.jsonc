// The staff console: a second Worker beside the gateway, in the same Cloudflare account (docs/DECISIONS.md, "Console hosting").
// Deployed by .github/workflows/console.yml: `wrangler deploy --config apps/console/wrangler.jsonc --env staging`.
{
  "name": "alo-king-console",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "observability": { "enabled": true },
  // 3.11: the day-close report to the founder at 21:40 Beirut in winter (22:40 in summer). Times are UTC.
  // D5: every two minutes, a web push for each new high-priority exception (src/push.ts); it does nothing until the VAPID secrets exist.
  "triggers": { "crons": ["40 19 * * *", "*/2 * * * *"] },
  "vars": { "ENVIRONMENT": "development", "KAPSO_BASE_URL": "https://api.kapso.ai/meta/whatsapp/v24.0", "MODEL_FAST": "claude-haiku-5-5" },
  // Bindings and vars are not inherited by environments, so each block is complete on purpose.
  "env": {
    "staging": {
      "name": "alo-king-console-staging",
      "workers_dev": true,
      "observability": { "enabled": true },
      "triggers": { "crons": ["40 19 * * *", "*/2 * * * *"] },
      "vars": { "ENVIRONMENT": "staging", "SENTRY_DSN": "https://a8adb1e4ba4769f28df5e5dc24d7576f@o4512423714488320.ingest.de.sentry.io/4512423723728976", "SENTRY_ORG": "alo-king", "SENTRY_API": "https://de.sentry.io", "KAPSO_BASE_URL": "https://api.kapso.ai/meta/whatsapp/v24.0", "MODEL_FAST": "claude-haiku-5-5" }
    },
    "production": {
      "name": "alo-king-console",
      "workers_dev": true,
      "observability": { "enabled": true },
      "triggers": { "crons": ["40 19 * * *", "*/2 * * * *"] },
      "vars": { "ENVIRONMENT": "production", "KAPSO_BASE_URL": "https://api.kapso.ai/meta/whatsapp/v24.0", "MODEL_FAST": "claude-haiku-5-5" }
    }
  }
  // Secrets, per environment (set by the console workflow, never in the repository): SUPABASE_URL, SUPABASE_SERVICE_KEY,
  // CONSOLE_SESSION_SECRET (made once in the workflow, kept across deploys), KAPSO_API_KEY, PHONE_NUMBER_ID_CUSTOMER, PHONE_NUMBER_ID_OPS,
  // and optionally ANTHROPIC_API_KEY (5.15's label reader; without it intake is typed by hand), and, for web push (D5), VAPID_PUBLIC_KEY,
  // VAPID_PRIVATE_KEY (raw base64url P-256 keys: `npx web-push generate-vapid-keys`) and VAPID_SUBJECT (`mailto:` or `https:`); without all three push is off.
  // The Kapso key and the two number ids are there only so replies and rider statements go out through the gateway module
  // (packages/wa/src/gateway.ts: preflight, can_send, outbox claim). The console has no other way to send.
}
