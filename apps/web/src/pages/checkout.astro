---
// WEB2: the checkout, one page that works with no script (each button posts the form and the page comes back with what changed).
//   1. Your number: until this device is signed in, the sign-in panel (docs/WEBSITE.md, "Identity and consent").
//   2. Where: a saved place, or a pin (this phone's location, a pasted map link or coordinates, or a location sent on WhatsApp), then house
//      and floor. The pin decides the village and the fee (save_customer_pin, 0074); the page never chooses either.
//   3. When: now, or one of the delivery windows the database lists for that village.
//   4. If an item is missing: for the order (closest match, message me first, leave it out), with an optional choice per item.
//   5. Payment: cash in dollars with the note (the chat's rule: a note on the list that is more than the total), cash in lira at today's rate
//      with the amount handed over, or a Whish or OMT transfer a person confirms. No card and no Whish Pay (they wait for the company).
//   6. The order card, the same words as the WhatsApp card (orderCardParts). "Send the order to my WhatsApp" makes the card and asks the
//      gateway to send it; the customer's Confirm tap there places the order (invariant 4; C1 as decided for WEB2). The page then becomes
//      the order page, which turns into the tracking view the moment the order is confirmed.
import Base from "../layouts/Base.astro";
import Unavailable from "../components/Unavailable.astro";
import Button from "@ak/ui-astro/Button.astro";
import Empty from "@ak/ui-astro/Empty.astro";
import Icon from "@ak/ui-astro/Icon.astro";
import "../styles/order.css";
import type { MissingPref, PaymentMethod } from "@ak/commerce/index";
import { orderCardParts } from "@ak/agents/order-card-text";
import { nameIn, t, usd } from "../lib/i18n";
import { sameOrigin } from "../lib/session";
import { chatWith, commerce, lbp, ordering, parsePin, seeOther, splitAmount, visitorOf, windowWords } from "../lib/order";
const { lang, env } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");
const cookie = Astro.request.headers.get("cookie");
const PREFS: MissingPref[] = ["best_match", "ask", "remove"];
const PAYS = ["cod_usd", "cod_lbp", "whish", "omt"] as const;
type Pay = (typeof PAYS)[number];
const uuid = (x: unknown) => (typeof x === "string" && /^[0-9a-f-]{36}$/.test(x) ? x : null);

let failed = false; let error = ""; let notice = "";
const posted = Astro.request.method === "POST";
if (posted && !sameOrigin(Astro.request, Astro.url)) return new Response("Forbidden", { status: 403 });
const form = posted ? await Astro.request.formData() : Astro.url.searchParams;
const get = (k: string) => { const x = form.get(k); return typeof x === "string" ? x : ""; };
let placeId = uuid(get("place"));
let slot = get("slot") === "" ? "now" : uuid(get("slot")) ?? "now";
const missing: MissingPref = (PREFS as string[]).includes(get("missing")) ? get("missing") as MissingPref : "ask";
const pay: Pay = (PAYS as readonly string[]).includes(get("pay")) ? get("pay") as Pay : "cod_usd";
const noteUsd = Number(get("note")) || null;
const noteLbp = Number(get("note_lbp")) || null;
const notes = get("notes").slice(0, 300);
const key = /^[\w-]{16,64}$/.test(get("key")) ? get("key") : crypto.randomUUID();
const itemPrefs: Record<string, MissingPref> = {};
for (const [k, val] of (posted ? [...(form as FormData).entries()] : [...(form as URLSearchParams).entries()])) {
  const m = /^item:(AK-\d{1,8})$/.exec(k);
  if (m && typeof val === "string" && (PREFS as string[]).includes(val) && val !== missing) itemPrefs[m[1]!] = val as MissingPref;
}
let pin: any = null;

let v; let facts: any; let account: any; let q: any; let windows: any[] = [];
try {
  v = await visitorOf(env, cookie);
  facts = await ordering(env).serviceFacts();
  if (v.linked && v.token) {
    const o = ordering(env);
    const act = get("do");
    if (posted && act === "pin") {
      const at = parsePin(get("pin")) ?? (get("lat") && get("lng") ? { lat: Number(get("lat")), lng: Number(get("lng")) } : null);
      if (!at) error = t(lang, "w2_pin_bad");
      else {
        pin = await o.savePin(v.token, at.lat, at.lng);
        if (pin.ok) placeId = pin.place_id;
        if (pin.status === "outside") error = t(lang, "w2_pin_outside");
        else if (pin.status === "located" && pin.served === false) error = t(lang, "w2_pin_not_served", { village: nameIn(lang, pin.village, pin.village_ar) });
        else if (pin.status === "located") notice = t(lang, "w2_pin_located", { village: nameIn(lang, pin.village, pin.village_ar) });
      }
    } else if (posted && act === "village" && placeId && uuid(get("village"))) {
      const r = await o.pinVillage(v.token, placeId, get("village"));
      if (!r.ok) error = t(lang, "w2_pin_bad");
    } else if (posted && act === "details" && placeId) {
      await o.placeDetails(v.token, placeId, { building: get("building") || null, floor: get("floor") || null, directions: get("directions") || null });
    } else if (posted && act === "place") {
      if (!placeId) error = t(lang, "w2_need_place");
      else {
        const payment: PaymentMethod = pay === "whish" ? "whish" : pay === "omt" ? "omt" : "cod";
        const r = await o.placeOrder(v.token, { requestKey: key, place: placeId, slot: slot === "now" ? null : slot, payment,
          cash: pay === "cod_lbp" ? "lbp" : pay === "cod_usd" ? "usd" : null, note: pay === "cod_lbp" ? noteLbp : pay === "cod_usd" ? noteUsd : null,
          missing, items: itemPrefs, notes: notes || null, lang });
        if (r.created && r.short_code && r.link) return seeOther(`/o/${encodeURIComponent(r.short_code)}?k=${encodeURIComponent(r.link)}`);
        const codes: string[] = [r.error, ...((r.issues ?? []) as any[]).map((i) => i.code)].filter(Boolean);
        const cap = ((r.issues ?? []) as any[]).find((i) => i.code === "first_order_cod_cap");
        error = cap ? t(lang, "w2_first_cap", { cap: usd(cap.max_cod_usd) })
          : codes.includes("note_too_small") ? t(lang, "w2_err_note_too_small")
          : codes.includes("unknown_note") ? t(lang, "w2_err_unknown_note")
          : codes.includes("closed") ? t(lang, "w2_err_closed")
          : codes.some((c) => c === "village_not_served" || c === "no_delivery_village") ? t(lang, "w2_err_village")
          : codes.some((c) => c === "fx_paused" || c === "no_exchange_rate") ? t(lang, "w2_err_fx")
          : codes.includes("empty_cart") ? t(lang, "w2_err_empty")
          : codes.some((c) => c.startsWith("slot_")) ? t(lang, "w2_err_window")
          : codes.includes("not_linked") ? t(lang, "w2_err_not_linked")
          : codes.length ? t(lang, "w2_err_not_ready") : t(lang, "w2_err_any");
      }
    }
    account = await o.account(v.token);
    const places: any[] = account.ok ? account.places : [];
    if (!placeId || !places.some((p) => p.place_id === placeId)) placeId = places[0]?.place_id ?? null;
    q = await commerce(env).checkoutQuote(v.token, { place: placeId, slot: slot === "now" ? null : slot });
    const here = places.find((p) => p.place_id === placeId);
    if (q.ok !== false && placeId) windows = await o.windows(v.token, q.village_id ?? null, !!q.quote?.bought_to_order);
    if (here && !here.building && !error && !notice) notice = t(lang, "w2_need_details");
  } else if (v.token) {
    q = await commerce(env).viewCart(v.token);
  }
} catch { failed = true; Astro.response.status = 503; }

const places: any[] = account?.ok ? account.places : [];
const place = places.find((p) => p.place_id === placeId) ?? null;
const quote = q?.quote ?? null;
const empty = !q || !(q.lines ?? []).length;
const issues: any[] = quote?.issues ?? q?.issues ?? [];
const closed = issues.some((i) => i.code === "closed");
const below = issues.find((i) => i.code === "below_minimum");
const total = quote ? Number(quote.total_usd) : 0;
const totalLbp = quote?.total_lbp ? Number(quote.total_lbp) : null;
const notesUsd: number[] = (facts?.notes_usd ?? []).map(Number).filter((n: number) => n > total);
const steps: number[] = (facts?.lbp_steps ?? []).map(Number);
const lbpChoices = totalLbp ? [...new Set(steps.map((s) => Math.ceil((totalLbp + 1) / s) * s))].filter((x) => x <= totalLbp + Math.max(...steps)).sort((a, b) => a - b) : [];
const firstCap = Number(facts?.first_order_max_cod_usd ?? 0);
// The card's words, as WhatsApp will show them: the same function, the quote the database gave, the choices on this page.
const parts = quote && placeId ? orderCardParts({ orderId: "", shortCode: "", lang, quote: { ...quote, window: slot === "now" ? null : quote.window }, paymentMethod: pay === "whish" ? "whish" : pay === "omt" ? "omt" : "cod",
  changeForUsd: pay === "cod_usd" ? noteUsd : null, changeForLbp: pay === "cod_lbp" ? noteLbp : null, missingPref: missing,
  missingItems: Object.entries(itemPrefs).map(([sku, pref]) => { const l = (quote.lines ?? []).find((x: any) => x.sku === sku); return { name: l?.name ?? sku, name_ar: l?.name_ar ?? null, pref }; }),
  window: slot === "now" ? null : windows.find((w) => w.slot_id === slot) ?? null,
  address: place ? { village_en: place.village, village_ar: place.village_ar, building: place.building, floor: place.floor } : null }) : null;
const chatLocation = chatWith(facts?.whatsapp, "📍");
const lineItems: { sku: string; name: string }[] = (q?.lines ?? []).map((l: any) => ({ sku: l.sku, name: nameIn(lang, l.name, l.name_ar) }));
---
<Base title={t(lang, "w2_checkout_title")} lang={lang} path="/checkout" whatsapp={facts?.whatsapp ?? null} noindex focus>
  {failed || !v ? <Unavailable lang={lang} /> : <div class="w2">
    <h1>{t(lang, "w2_checkout_title")}</h1>
    {empty ? <Empty title={t(lang, "w2_basket_empty")} text={t(lang, "w2_basket_empty_text")} icon="cart" action={undefined} />
    : !v.linked ? <section>
        <h2>{t(lang, "w2_signin_title")}</h2>
        <p class="muted">{t(lang, "w2_signin_lead", { days: facts?.session_days ?? 90 })}</p>
        {facts?.whatsapp ? <form method="post" action="/signin"><input type="hidden" name="next" value="/checkout">
          <Button label={t(lang, "w2_signin_button")} icon="chat" variant="primary" size="lg" block /></form> : <p>{t(lang, "w2_signin_no_wa")}</p>}
        <p class="muted small">{t(lang, "w2_signin_consent")}</p>
      </section>
    : <form method="post" action="/checkout" class="w2">
        <input type="hidden" name="key" value={key}>
        {error && <p class="w2-note warn" role="alert">{error}</p>}
        {notice && !error && <p class="w2-note" role="status">{notice}</p>}
        {(q?.removed ?? []).length > 0 && <div class="w2-note warn"><p>{t(lang, "w2_sold_out")}</p><ul>{q.removed.map((r: any) => <li>{nameIn(lang, r.name, r.name_ar)}</li>)}</ul></div>}

        <section>
          <fieldset>
            <legend>{t(lang, "w2_step_place")}</legend>
            {places.length === 0 && <p class="muted">{t(lang, "w2_no_places")}</p>}
            {places.map((p) => <label class="w2-choice"><input type="radio" name="place" value={p.place_id} checked={p.place_id === placeId}>
              <span>{nameIn(lang, p.village, p.village_ar) || "—"}{p.building ? ` · ${p.building}` : ""}{p.floor ? ` · ${p.floor}` : ""}
                <small>{p.has_pin ? t(lang, "w2_has_pin") : t(lang, "w2_no_pin")}{p.served === false ? ` · ${t(lang, "w2_pin_not_served", { village: nameIn(lang, p.village, p.village_ar) })}` : ""}</small></span></label>)}
          </fieldset>
          {pin?.status === "unsure" && (pin.candidates ?? []).length > 0 && <fieldset>
            <legend>{t(lang, "w2_pin_unsure")}</legend>
            {pin.candidates.map((c: any) => <label class="w2-choice"><input type="radio" name="village" value={c.village_id}><span>{nameIn(lang, c.name_en, c.name_ar)}</span></label>)}
            <Button label={t(lang, "w2_pin_choose")} name="do" value="village" variant="soft" />
          </fieldset>}
          <div class="w2-row">
            <Button label={t(lang, "w2_use_location")} name="do" value="pin" icon="pin" variant="soft" attrs={{ "data-geo": "" }} />
            <input type="hidden" name="lat" value=""><input type="hidden" name="lng" value="">
          </div>
          <p class="muted small">{t(lang, "w2_location_hint")}</p>
          <div class="w2-row">
            <label class="ak-field"><span>{t(lang, "w2_paste_pin")}</span><input class="ak-input" name="pin" maxlength="500" placeholder={t(lang, "w2_paste_hint")} autocomplete="off"></label>
            <Button label={t(lang, "w2_save_pin")} name="do" value="pin" variant="soft" />
          </div>
          {chatLocation && <p class="small"><a href={chatLocation} rel="noopener" target="_blank">{t(lang, "w2_send_location")}</a> · {t(lang, "w2_send_location_hint")} <Button label={t(lang, "w2_refresh")} name="do" value="update" variant="ghost" size="sm" /></p>}
          {place && <div class="w2-row">
            <label class="ak-field"><span>{t(lang, "w2_house")}</span><input class="ak-input" name="building" maxlength="120" value={place.building ?? ""}></label>
            <label class="ak-field"><span>{t(lang, "w2_floor")}</span><input class="ak-input" name="floor" maxlength="40" value={place.floor ?? ""}></label>
            <Button label={t(lang, "w2_save")} name="do" value="details" variant="soft" />
          </div>}
        </section>

        <section>
          <fieldset>
            <legend>{t(lang, "w2_step_when")}</legend>
            {closed && <p class="w2-note warn">{t(lang, "w2_now_closed")}</p>}
            {!closed && <label class="w2-choice"><input type="radio" name="slot" value="now" checked={slot === "now"}><span>{quote?.eta_minutes ? t(lang, "w2_now_eta", { n: quote.eta_minutes }) : t(lang, "w2_now")}</span></label>}
            {windows.map((w) => <label class="w2-choice"><input type="radio" name="slot" value={w.slot_id} checked={slot === w.slot_id}><span>{windowWords(w, lang)}</span></label>)}
            {closed && windows.length === 0 && <p class="muted">{t(lang, "w2_windows_none")}</p>}
          </fieldset>
        </section>

        <section>
          <fieldset>
            <legend>{t(lang, "w2_step_missing")}</legend>
            {PREFS.map((p) => <label class="w2-choice"><input type="radio" name="missing" value={p} checked={missing === p}><span>{t(lang, `w2_missing_${p}`)}</span></label>)}
            <details><summary>{t(lang, "w2_missing_per_item")}</summary>
              {lineItems.map((l) => <label class="ak-field"><span>{l.name}</span><select class="ak-select" name={`item:${l.sku}`}>
                <option value="">{t(lang, "w2_missing_same")}</option>{PREFS.map((p) => <option value={p} selected={itemPrefs[l.sku] === p}>{t(lang, `w2_missing_${p}`)}</option>)}</select></label>)}
            </details>
          </fieldset>
        </section>

        <section>
          <fieldset>
            <legend>{t(lang, "w2_step_pay")}</legend>
            <label class="w2-choice"><input type="radio" name="pay" value="cod_usd" checked={pay === "cod_usd"}><span>{t(lang, "w2_pay_usd")}</span></label>
            {pay === "cod_usd" && notesUsd.length > 0 && <label class="ak-field"><span>{t(lang, "w2_note")}</span><select class="ak-select" name="note">
              <option value="">{t(lang, "w2_note_exact")}</option>{notesUsd.map((n) => <option value={String(n)} selected={noteUsd === n}>{usd(n)}</option>)}</select></label>}
            <label class="w2-choice"><input type="radio" name="pay" value="cod_lbp" checked={pay === "cod_lbp"}><span>{t(lang, "w2_pay_lbp")}</span></label>
            {facts?.fx_rate_lbp && <p class="muted small">{t(lang, "w2_pay_rate")} <bdi>{lbp(lang, facts.fx_rate_lbp)}</bdi></p>}
            {pay === "cod_lbp" && lbpChoices.length > 0 && <fieldset><legend class="small">{t(lang, "w2_note_lbp")}</legend>
              <label class="w2-choice"><input type="radio" name="note_lbp" value="" checked={!noteLbp}><span>{t(lang, "w2_note_exact")}</span></label>
              {lbpChoices.map((n) => <label class="w2-choice"><input type="radio" name="note_lbp" value={String(n)} checked={noteLbp === n}><span><bdi>{lbp(lang, n)}</bdi></span></label>)}</fieldset>}
            <label class="w2-choice"><input type="radio" name="pay" value="whish" checked={pay === "whish"}><span>{t(lang, "w2_pay_whish")}</span></label>
            <label class="w2-choice"><input type="radio" name="pay" value="omt" checked={pay === "omt"}><span>{t(lang, "w2_pay_omt")}</span></label>
            {(pay === "whish" || pay === "omt") && <p class="muted small">{t(lang, "w2_pay_transfer_note")}</p>}
            {firstCap > 0 && total > firstCap && pay.startsWith("cod") && <p class="w2-note warn">{t(lang, "w2_first_cap", { cap: usd(firstCap) })}</p>}
            <p class="muted small">{t(lang, "w2_no_card")}</p>
          </fieldset>
          <label class="ak-field"><span>{t(lang, "w2_step_notes")}</span><textarea name="notes" maxlength="300">{notes}</textarea></label>
          <Button label={t(lang, "w2_update")} name="do" value="update" variant="ghost" icon="refresh" />
        </section>

        <section>
          <h2>{t(lang, "w2_card")}</h2>
          {below && <p class="w2-note warn">{t(lang, "w2_min_missing", { min: usd(below.minimum_usd), gap: usd(Math.max(0, Number(below.minimum_usd) - Number(below.subtotal_usd))) })}</p>}
          {parts && <div class="w2-card">
            <ul>{parts.items.map((x, i) => i % 2 === 0 ? <li><span>{x}</span><bdi>{parts.items[i + 1]}</bdi></li> : null)}</ul>
            <ul>{parts.sums.map((s) => { const [a, b] = splitAmount(s); return b ? <li class={/\*/.test(s) ? "total" : ""}><span>{a}</span><bdi>{b}</bdi></li> : <li><span>{a}</span></li>; })}</ul>
            <ul class="terms">{parts.terms.filter((x) => x.trim()).map((x) => <li>{x.replace(/\*/g, "")}</li>)}</ul>
          </div>}
          <p class="w2-big">{t(lang, "w2_confirm_on_wa")}</p>
          <Button label={t(lang, "w2_send_card")} name="do" value="place" variant="gold" size="lg" icon="chat" block disabled={!placeId || !!below} />
        </section>
      </form>}
  </div>}
</Base>
