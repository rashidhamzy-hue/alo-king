---
// WEB2: sign-in exactly as docs/WEBSITE.md "Identity and consent" says. "Confirm your number on WhatsApp" makes a code for this device
// (web_link_code, 0129) and opens our customer number with the code typed. The customer presses send; the customer-line turn reads the code
// by code, with no model (turn.ts), links this session to that number and records consent. This page follows with no script (it reloads
// itself while a code waits) and, once linked, keeps the device signed in for settings.web.session_days (90). No password, no SMS: the
// customer's own message is the proof, so we never message someone who has not messaged us (invariant 17).
import Base from "../layouts/Base.astro";
import Unavailable from "../components/Unavailable.astro";
import Button from "@ak/ui-astro/Button.astro";
import Icon from "@ak/ui-astro/Icon.astro";
import "../styles/order.css";
import { t } from "../lib/i18n";
import { sameOrigin, sessionCookie } from "../lib/session";
import { chatWith, commerce, ordering, safeBack, seeOther, tokenForWrite, visitorOf } from "../lib/order";
const { lang, env } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");
const cookie = Astro.request.headers.get("cookie");
let failed = false;
const next = safeBack(Astro.url.searchParams.get("next"), "/account");
if (Astro.request.method === "POST") {
  if (!sameOrigin(Astro.request, Astro.url)) return new Response("Forbidden", { status: 403 });
  const form = await Astro.request.formData();
  const to = safeBack(String(form.get("next") ?? ""), "/account");
  try {
    const v = await visitorOf(env, cookie);
    const { token, setCookie } = await tokenForWrite(env, v);
    if (!v.linked) await commerce(env).linkCode(token);
    return seeOther(`/signin?next=${encodeURIComponent(to)}`, setCookie);
  } catch { failed = true; Astro.response.status = 503; }
}
let v; let facts;
try { v = await visitorOf(env, cookie); facts = await ordering(env).serviceFacts(); } catch { failed = true; Astro.response.status = 503; }
// Linked: the cookie now lasts as long as the session does (90 days from the claim).
if (v?.linked && v.token && v.expiresAt) Astro.response.headers.append("Set-Cookie", sessionCookie(v.token, v.expiresAt));
const wa = facts?.whatsapp ?? null;
const code = v && !v.linked ? v.code?.code ?? null : null;
const chatOpen = code ? chatWith(wa, code) : null;
---
<Base title={t(lang, "w2_signin_title")} lang={lang} path="/signin" whatsapp={wa} noindex refresh={code ? 5 : null}>
  {failed || !v ? <Unavailable lang={lang} /> : <div class="w2 split">
    <h1>{v.linked ? t(lang, "w2_signin_done") : t(lang, "w2_signin_title")}</h1>
    <div class="full"><p class="lead">{t(lang, "w2_signin_lead", { days: facts?.session_days ?? 90 })}</p></div>
    <ul class="w2-perks">
      <li><Icon name="orders" /><span><strong>{t(lang, "w2_signin_b1")}</strong>{t(lang, "w2_signin_b1_text")}</span></li>
      <li><Icon name="pin" /><span><strong>{t(lang, "w2_signin_b2")}</strong>{t(lang, "w2_signin_b2_text")}</span></li>
      <li><Icon name="shield" /><span><strong>{t(lang, "w2_signin_b3")}</strong>{t(lang, "w2_signin_b3_text")}</span></li>
    </ul>
    <div class="panel">
      {v.linked
        ? <><p class="w2-big"><Icon name="check" /> {t(lang, "w2_signin_done")}</p><Button label={t(lang, "w2_signin_continue")} href={next} variant="gold" size="lg" /></>
        : !wa ? <p>{t(lang, "w2_signin_no_wa")}</p>
        : code && chatOpen
          ? <>
              <ol class="w2-steps"><li>{t(lang, "w2_signin_step1")}</li><li>{t(lang, "w2_signin_step2")}</li><li>{t(lang, "w2_signin_step3")}</li></ol>
              <p>{t(lang, "w2_signin_code")}: <span class="w2-code">{code}</span></p>
              <Button label={t(lang, "w2_signin_open")} href={chatOpen} icon="chat" variant="whatsapp" size="lg" external attrs={{ target: "_blank" }} />
              <p class="muted" role="status">{t(lang, "w2_signin_waiting")} {t(lang, "w2_signin_expires", { n: facts?.link_code_minutes ?? 10 })}</p>
              <p class="muted small">{t(lang, "w2_signin_consent")}</p>
            </>
          : <form method="post" action="/signin">
              <input type="hidden" name="next" value={next}>
              <ol class="w2-steps"><li>{t(lang, "w2_signin_step1")}</li><li>{t(lang, "w2_signin_step2")}</li><li>{t(lang, "w2_signin_step3")}</li></ol>
              <Button label={t(lang, "w2_signin_button")} icon="chat" variant="primary" size="lg" block />
              <p class="muted small">{t(lang, "w2_signin_consent")}</p>
            </form>}
    </div>
  </div>}
</Base>
