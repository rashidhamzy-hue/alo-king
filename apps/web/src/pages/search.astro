---
// Search (redesigned in DS1; docs/strategy/05, section B): the chat's own matcher (Arabic, Arabizi, English, French), results as
// cards, and a plain "we do not have this yet" that the database logs as demand. With scripts on, the results follow the typing
// (public/site.js asks this same page after a pause and swaps the results in); with scripts off the form works as before.
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import Unavailable from "../components/Unavailable.astro";
import Button from "@ak/ui-astro/Button.astro";
import { t, withGreeting } from "../lib/i18n";
const { lang, catalog, env } = Astro.locals;
const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 80);
let r; let failed = false; let ask: string | null = null; let product: string | null = null;
if (q.length >= 2) {
  try {
    r = await catalog().search(q);
    // The chat's address: for the door on every page, for one item's own button, and for a search that found nothing.
    try { const w = (await catalog().home()).whatsapp; ask = w.home; product = w.product; } catch { /* the page is complete without it */ }
  } catch { failed = true; Astro.response.status = 503; }
}
Astro.response.headers.set("Cache-Control", "no-store");
const found = r?.matches ?? [];
const anyCredit = found.some((i) => i.picture?.licence === "cc_by_sa");
---
<Base title={q ? t(lang, "search_results", { q }) : t(lang, "search")} lang={lang} q={q} path={`/search?q=${encodeURIComponent(q)}`} whatsapp={ask} live>
  {failed ? <Unavailable lang={lang} /> : <div data-live aria-live="polite">
    <h1>{q ? t(lang, "search_results", { q }) : t(lang, "search")}</h1>
    {q.length === 0 && <p class="muted">{t(lang, "live_hint")}</p>}
    {q.length > 0 && q.length < 2 && <p class="muted">{t(lang, "search_short")}</p>}
    {r && found.length > 0 && <>
      <p class="muted">{t(lang, "search_found", { n: found.length })}</p>
      <ul class="ak-grid">{found.map((item) => <Card item={item} lang={lang} env={env} whatsapp={product} />)}</ul>
      {anyCredit && <p class="muted small credit">{t(lang, "credit_pictures")}</p>}
    </>}
    {r && found.length === 0 && <>
      <p>{t(lang, "search_none", { q })}</p>
      {ask && <p><Button label={t(lang, "try_whatsapp")} href={withGreeting(ask, lang)!} icon="chat" external /></p>}
    </>}
  </div>}
</Base>
