---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import Unavailable from "../components/Unavailable.astro";
import { t } from "../lib/i18n";
const { lang, catalog, env } = Astro.locals;
const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 80);
let r; let failed = false; let ask: string | null = null;
if (q.length >= 2) {
  try {
    r = await catalog().search(q);
    // Nothing found: offer the chat, where a person can help. (The miss itself was logged by the database.)
    if (r.matches.length === 0) { try { ask = (await catalog().home()).whatsapp.home; } catch { /* the page is complete without it */ } }
  } catch { failed = true; Astro.response.status = 503; }
}
Astro.response.headers.set("Cache-Control", "no-store");
const found = r?.matches ?? [];
const anyCredit = found.some((i) => i.picture?.licence === "cc_by_sa");
---
<Base title={q ? t(lang, "search_results", { q }) : t(lang, "search")} lang={lang} q={q} path={`/search?q=${encodeURIComponent(q)}`}>
  {failed ? <Unavailable lang={lang} /> : <>
    <h1>{q ? t(lang, "search_results", { q }) : t(lang, "search")}</h1>
    {q.length > 0 && q.length < 2 && <p class="muted">{t(lang, "search_short")}</p>}
    {r && found.length > 0 && <>
      <p class="muted">{t(lang, "search_found", { n: found.length })}</p>
      <ul class="grid">{found.map((item) => <Card item={item} lang={lang} env={env} />)}</ul>
      {anyCredit && <p class="muted small credit">{t(lang, "credit_pictures")}</p>}
    </>}
    {r && found.length === 0 && <>
      <p>{t(lang, "search_none", { q })}</p>
      {ask && <p><a class="btn alt" href={ask} rel="noopener">{t(lang, "try_whatsapp")}</a></p>}
    </>}
  </>}
</Base>
