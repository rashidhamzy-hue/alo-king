---
// WEB2: the signed-in person's orders, from WhatsApp and the website together (one history; web_orders, 0229), newest first, each with its
// status from the one label table and a link to its order page. "Order again" puts the order's basket in the cart at today's prices
// (basket_from_order, 0118, through web_order_again): anything that cannot be sold now is named first and left out. Never cached.
import Base from "../layouts/Base.astro";
import Unavailable from "../components/Unavailable.astro";
import Button from "@ak/ui-astro/Button.astro";
import Empty from "@ak/ui-astro/Empty.astro";
import StatusPill from "@ak/ui-astro/StatusPill.astro";
import "../../../../packages/ui/styles/components.more.css";
import "../styles/order.css";
import { nameIn, t, usd } from "../lib/i18n";
import { sameOrigin } from "../lib/session";
import { basketCookie, dateWords, ordering, commerce, seeOther, statusWords, visitorOf } from "../lib/order";
const { lang, env } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");
const cookie = Astro.request.headers.get("cookie");
let failed = false;
if (Astro.request.method === "POST") {
  if (!sameOrigin(Astro.request, Astro.url)) return new Response("Forbidden", { status: 403 });
  const form = await Astro.request.formData();
  const id = String(form.get("order") ?? "");
  try {
    const v = await visitorOf(env, cookie);
    if (v.linked && v.token && form.get("do") === "again" && /^[0-9a-f-]{36}$/.test(id)) {
      const r = await ordering(env).orderAgain(v.token, id);
      if (r.ok) {
        const cart = await commerce(env).viewCart(v.token);
        const res = seeOther(`/cart?again=1${r.missing.length ? `&missing=${r.missing.map((m: any) => m.sku).join(",")}` : ""}`);
        res.headers.append("Set-Cookie", basketCookie((cart.lines ?? []).reduce((a, l) => a + Number(l.qty), 0)));
        return res;
      }
    }
    return seeOther("/orders");
  } catch { failed = true; Astro.response.status = 503; }
}
let v; let r: any = null; let facts: any = null;
try {
  v = await visitorOf(env, cookie);
  facts = await ordering(env).serviceFacts();
  if (v.linked && v.token) r = await ordering(env).orders(v.token);
} catch { failed = true; Astro.response.status = 503; }
const sl = (lang === "ar" ? "ar" : "en") as "ar" | "en";
---
<Base title={t(lang, "w2_orders_title")} lang={lang} path="/orders" whatsapp={facts?.whatsapp ?? null} noindex>
  {failed || !v ? <Unavailable lang={lang} /> : <div class="w2">
    <h1>{t(lang, "w2_orders_title")}</h1>
    {!v.linked ? <section><p>{t(lang, "w2_need_signin")}</p><form method="post" action="/signin"><input type="hidden" name="next" value="/orders"><Button label={t(lang, "w2_signin_button")} icon="chat" variant="primary" /></form></section>
    : !r?.ok || r.orders.length === 0 ? <Empty title={t(lang, "w2_orders_none")} icon="orders" />
    : <ul class="w2-orders">{r.orders.map((o: any) => (
        <li>
          <div class="top"><strong><bdi>{o.short_code}</bdi></strong><StatusPill id={o.status} audience="customer" lang={sl} pickup={o.pickup} />{lang === "fr" && <span class="muted small">{statusWords(o.status, lang, o.pickup)}</span>}</div>
          <span class="meta">{o.channel === "web" ? t(lang, "w2_on_web") : t(lang, "w2_on_whatsapp")} · {dateWords(o.created_at, lang, facts?.hours?.tz)} · {t(lang, "w2_items_n", { n: o.items })} · <bdi>{usd(o.total_usd)}</bdi></span>
          <span class="small">{o.names.map((x: any) => nameIn(lang, x.name_en, x.name_ar)).join(" · ")}</span>
          <div class="w2-actions">
            {o.link && <Button label={t(lang, "w2_view")} href={`/o/${encodeURIComponent(o.short_code)}?k=${encodeURIComponent(o.link)}`} variant="soft" size="sm" />}
            {o.status !== "awaiting_confirmation" && <form method="post" action="/orders"><input type="hidden" name="order" value={o.order_id}><Button label={t(lang, "w2_order_again")} name="do" value="again" variant="ghost" size="sm" icon="refresh" /></form>}
          </div>
        </li>))}
      </ul>}
  </div>}
</Base>
