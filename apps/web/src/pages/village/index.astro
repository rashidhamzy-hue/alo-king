---
// WEB4a: the village picker as a page. The header's chip and the home page open the same list in place; this page is where "Use my location"
// lands when it needs a choice (the position is between villages: `near`) or found none (`outside`), and the picker itself with no script.
// POST (from any picker): the chosen village's id goes in the `ak_village` cookie (the id only), and the visitor goes back where they were.
// Only a served village is kept; anything else clears the choice. Nothing else is stored.
import Base from "../../layouts/Base.astro";
import { PickerBody } from "../../components/ref/Frame";
import { t } from "../../lib/i18n";
import { chatWith, seeOther } from "../../lib/order";
import { backTo, frameOf, villageCookie } from "../../lib/frame";
import { sameOrigin } from "../../lib/session";
import { Price } from "../../components/ref/ui";
const { lang, env } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");
const cookie = Astro.request.headers.get("cookie");
const back = backTo(Astro.url.searchParams.get("back"), false);
if (Astro.request.method === "POST") {
  if (!sameOrigin(Astro.request, Astro.url)) return new Response("Forbidden", { status: 403, headers: { "Content-Type": "text/plain; charset=utf-8" } });
  const form = await Astro.request.formData();
  const id = String(form.get("village") ?? "");
  const f = await frameOf(env, cookie, { lang, path: "/" });
  const ok = /^[0-9a-f-]{36}$/.test(id) && f.villages.some((v) => v.id === id);
  return seeOther(backTo(String(form.get("back") ?? ""), ok), villageCookie(ok ? id : null));
}
const f = await frameOf(env, cookie, { lang, path: "/village" });
const near = (Astro.url.searchParams.get("near") ?? "").split(",").filter((x) => /^[0-9a-f-]{36}$/.test(x));
const choices = f.villages.filter((v) => near.includes(v.id));
const outside = Astro.url.searchParams.get("outside") === "1";
const failed = Astro.url.searchParams.get("failed") === "1";
const ask = chatWith(f.chat, t(lang, "wa_greeting"));
---
<Base title={t(lang, "w4_picker_title")} lang={lang} path="/village" frame={f} noindex>
  <h1>{t(lang, "w4_picker_title")}</h1>
  {failed && <p class="w2-note warn" role="status">{t(lang, "w4_locate_failed")}</p>}
  {outside && <div class="w2-note warn" role="status"><p><strong>{t(lang, "w4_outside")}</strong></p><p>{t(lang, "w4_outside_text")}</p>
    {ask && <p><a href={ask} target="_blank" rel="noopener">{t(lang, "w4_ask_wa")}</a></p>}</div>}
  {choices.length > 0 && <section class="ak-card">
    <h2>{t(lang, "w4_unsure")}</h2>
    <form method="post" action="/village" class="actions">
      <input type="hidden" name="back" value={back}>
      {choices.map((v) => <button class="ak-btn ak-btn--soft" type="submit" name="village" value={v.id}>{v.name} · {t(lang, "w4_eta", { n: v.eta })} · <Price value={v.fee} /></button>)}
    </form>
  </section>}
  <div class="ak-card picker-page"><PickerBody f={f} idp="page" back={back} /></div>
</Base>
