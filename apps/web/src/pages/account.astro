---
// WEB2: the account. Saved places (from the database; added at the checkout or by a pin on WhatsApp), the page language, what we remember
// (customer_memory_view, 0019, without the contact phone: the same view the chat's "what do you know about me" answers from), forget (the same
// forget the chat uses, so forgetting here forgets in the chat), stop or start remembering, sign out of this device, and sign out on every
// device. Never cached; nothing here is shown to anyone but the signed-in person.
import Base from "../layouts/Base.astro";
import Unavailable from "../components/Unavailable.astro";
import Button from "@ak/ui-astro/Button.astro";
import Icon from "@ak/ui-astro/Icon.astro";
import "../styles/order.css";
import { LANGS, LANG_NAMES, nameIn, t } from "../lib/i18n";
import { sameOrigin } from "../lib/session";
import { clearCookie, commerce, dateWords, ordering, seeOther, visitorOf } from "../lib/order";
const { lang, env } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");
const cookie = Astro.request.headers.get("cookie");
let failed = false;
if (Astro.request.method === "POST") {
  if (!sameOrigin(Astro.request, Astro.url)) return new Response("Forbidden", { status: 403 });
  const act = String((await Astro.request.formData()).get("do") ?? "");
  try {
    const v = await visitorOf(env, cookie);
    if (v.token) {
      const o = ordering(env);
      if (act === "signout") { await commerce(env).endSession(v.token); return seeOther("/account?done=signout", clearCookie); }
      if (act === "signout_all" && v.linked) { await o.signOutEverywhere(v.token); return seeOther("/account?done=signout_all", clearCookie); }
      if (act === "forget" && v.linked) { await o.forget(v.token); return seeOther("/account?done=forget"); }
      if ((act === "stop" || act === "start") && v.linked) { await o.memoryPref(v.token, act === "start"); return seeOther("/account"); }
    }
    return seeOther("/account");
  } catch { failed = true; Astro.response.status = 503; }
}
let v; let a: any = null; let facts: any = null;
try {
  v = await visitorOf(env, cookie);
  facts = await ordering(env).serviceFacts();
  if (v.linked && v.token) a = await ordering(env).account(v.token);
} catch { failed = true; Astro.response.status = 503; }
const done = Astro.url.searchParams.get("done");
const m = a?.memory ?? null;
const list = (xs: unknown) => (Array.isArray(xs) ? xs.filter(Boolean).map(String) : []);
const payWord = (p: string | null) => (p === "cod" ? t(lang, "w2_pay_cod") : p === "whish" ? t(lang, "w2_pay_whish") : p === "omt" ? t(lang, "w2_pay_omt") : null);
---
<Base title={t(lang, "w2_account_title")} lang={lang} path="/account" whatsapp={facts?.whatsapp ?? null} noindex>
  {failed || !v ? <Unavailable lang={lang} /> : <div class="w2">
    <h1>{t(lang, "w2_account_title")}</h1>
    {done === "signout" && <p class="w2-note ok" role="status">{t(lang, "w2_signed_out")}</p>}
    {done === "signout_all" && <p class="w2-note ok" role="status">{t(lang, "w2_signout_all_done")}</p>}
    {done === "forget" && <p class="w2-note ok" role="status">{t(lang, "w2_forget_done")}</p>}
    {!a?.ok ? <section><p>{t(lang, "w2_need_signin")}</p><form method="post" action="/signin"><input type="hidden" name="next" value="/account"><Button label={t(lang, "w2_signin_button")} icon="chat" variant="whatsapp" /></form></section>
    : <>
      <section><h2>{t(lang, "w2_places")}</h2>
        {a.places.length === 0 ? <p class="muted">{t(lang, "w2_no_places")}</p>
          : <ul>{a.places.map((p: any) => <li>{nameIn(lang, p.village, p.village_ar) || "—"}{p.building ? ` · ${p.building}` : ""}{p.floor ? ` · ${p.floor}` : ""} <span class="muted small">({p.has_pin ? t(lang, "w2_has_pin") : t(lang, "w2_no_pin")})</span></li>)}</ul>}
      </section>
      <section><h2>{t(lang, "w2_language")}</h2>
        <div class="w2-actions">{LANGS.map((l) => <Button label={LANG_NAMES[l]} href={`/lang?set=${l}&next=/account`} variant={l === lang ? "primary" : "ghost"} size="sm" />)}</div>
      </section>
      <section><h2>{t(lang, "w2_memory")}</h2>
        <p class="muted">{t(lang, "w2_memory_intro")}</p>
        {m && !m.remember && <p class="w2-note warn">{t(lang, "w2_mem_paused")}</p>}
        {m && <dl class="w2-sums">
          <div><dt>{t(lang, "w2_mem_restrictions")}</dt><dd>{list(m.restrictions).join(" · ") || t(lang, "w2_mem_none")}</dd></div>
          <div><dt>{t(lang, "w2_mem_usuals")}</dt><dd>{list(m.usuals).join(" · ") || t(lang, "w2_mem_none")}</dd></div>
          <div><dt>{t(lang, "w2_mem_brands")}</dt><dd>{list(m.brands).join(" · ") || t(lang, "w2_mem_none")}</dd></div>
          <div><dt>{t(lang, "w2_mem_notes")}</dt><dd>{list(m.notes).join(" · ") || t(lang, "w2_mem_none")}</dd></div>
          <div><dt>{t(lang, "w2_mem_payment")}</dt><dd>{payWord(m.payment) ?? t(lang, "w2_mem_none")}</dd></div>
        </dl>}
        <form method="post" action="/account" class="w2-actions">
          <Button label={t(lang, "w2_forget")} name="do" value="forget" variant="danger" size="sm" />
          {m?.remember ? <Button label={t(lang, "w2_stop")} name="do" value="stop" variant="ghost" size="sm" /> : <Button label={t(lang, "w2_start")} name="do" value="start" variant="ghost" size="sm" />}
        </form>
      </section>
      <section><h2><Icon name="shield" /> {t(lang, "w2_signout")}</h2>
        {v.expiresAt && <p class="muted">{t(lang, "w2_signed_in_until", { date: dateWords(v.expiresAt, lang, facts?.hours?.tz) })}</p>}
        <form method="post" action="/account" class="w2-actions">
          <Button label={t(lang, "w2_signout")} name="do" value="signout" variant="ghost" icon="signout" />
          <Button label={t(lang, "w2_signout_all")} name="do" value="signout_all" variant="danger" />
        </form>
        <p class="muted small">{t(lang, "w2_signout_wa")}</p>
      </section>
    </>}
  </div>}
</Base>
