---
// Ride with Alo King (session UX3; the founder's reference, "join.rider", with our real rules). Who can ride, what a rider keeps (the whole delivery fee and all tips,
// invariant 10), the cash limit and the written terms, then an application. Every amount, shift and village is read from the database (web_join_options): nothing is
// written here (invariant 13). The number is confirmed the WEB2 way (a code the applicant sends to us first: invariant 17); there is no number field. An application
// creates an application and a staff case. It never creates a rider: a person decides, on the console.
import Base from "../../layouts/Base.astro";
import Unavailable from "../../components/Unavailable.astro";
import ConfirmNumber from "../../components/ConfirmNumber.astro";
import Button from "@ak/ui-astro/Button.astro";
import Field from "@ak/ui-astro/Field.astro";
import Icon from "@ak/ui-astro/Icon.astro";
import { chatBase, t } from "../../lib/i18n";
import { DAYS, dayName, money, refusal, riderApplication, riderProblem, riderValues, shiftName, vehicleName, villageText, type RiderValues } from "../../lib/join";
import { sameOrigin, tokenOf, withSession } from "../../lib/session";
import type { JoinOptions, JoinState } from "@ak/commerce/index";
const { lang, join, env } = Astro.locals;
const path = "/join/rider";
const PURPOSE = "rider" as const;
const req = Astro.request;
const cookie = req.headers.get("cookie");
let failed = false; let error = ""; let setCookie: string | null = null;
let values: RiderValues = { name: "", village: "", vehicle: "", licence: "", days: [], shifts: [] };
const back = (to: string, c: string | null) => { const h = new Headers({ Location: to, "Cache-Control": "no-store" }); if (c) h.append("Set-Cookie", c); return new Response(null, { status: 303, headers: h }); };

if (req.method === "POST") {
  if (!sameOrigin(req, Astro.url)) return new Response("Forbidden", { status: 403, headers: { "Content-Type": "text/plain; charset=utf-8" } });
  const form = await req.formData();
  const step = String(form.get("step") ?? "");
  try {
    if (step === "code") {
      const r = await withSession(env, cookie, (token) => join().code(token, PURPOSE));
      return back(`${path}#confirm`, r.setCookie);
    }
    if (step === "apply") {
      values = riderValues(form);
      const options = await join().options();
      const problem = riderProblem(values, options);
      if (problem) { error = t(lang, problem); Astro.response.status = 400; }
      else {
        const r = await withSession(env, cookie, (token) => join().applyRider(token, riderApplication(values)));
        setCookie = r.setCookie;
        if (r.result.ok) return back(`${path}?applied=1`, r.setCookie);
        error = t(lang, refusal(r.result)); Astro.response.status = 400;
      }
    }
  } catch { failed = true; Astro.response.status = 503; }
}
if (setCookie) Astro.response.headers.append("Set-Cookie", setCookie);

let options: JoinOptions | null = null; let state: JoinState | null = null;
try {
  options = await join().options();
  const token = tokenOf(setCookie) ?? tokenOf(cookie);
  state = token ? await join().state(token, PURPOSE) : null;
} catch { failed = true; Astro.response.status = 503; }
const o = options;
const linked = state?.valid === true && state.linked;
const applied = state?.application ?? null;
const chat = chatBase(o?.whatsapp);
const fees = o?.fees && o.fees.max_usd > o.fees.min_usd ? t(lang, "join_fee_range", { min: money(o.fees.min_usd), max: money(o.fees.max_usd) }) : "";
const vehicles = o ? o.vehicles.map((v) => vehicleName(lang, v)).join(lang === "ar" ? "، " : ", ") : "";
---
<Base title={t(lang, "join_rider_eyebrow")} lang={lang} description={t(lang, "join_rider_lead")} path={Astro.url.pathname} whatsapp={chat}>
  {failed || !o ? <Unavailable lang={lang} /> : <div class="join">
    <section class="hero">
      <div>
        <p class="eyebrow">{t(lang, "join_rider_eyebrow")}</p>
        <h1>{t(lang, "join_rider_title")}</h1>
        <p>{t(lang, "join_rider_lead")}</p>
        <div class="cta">
          <Button label={t(lang, "join_apply_cta")} href="#apply" variant="gold" size="lg" />
          <Button label={t(lang, "join_how_cta")} href="#earn" variant="soft" size="lg" />
        </div>
      </div>
    </section>

    <h2 id="earn">{t(lang, "join_earn_h")}</h2>
    <ul class="tiles">
      <li><Icon name="coins" /><h3>{t(lang, "join_fee_t")}</h3><p>{fees && <>{fees} </>}{t(lang, "join_fee_text")}</p></li>
      <li><Icon name="wallet" /><h3>{t(lang, "join_tips_t")}</h3><p>{t(lang, "join_tips_text")}</p></li>
      <li><Icon name="bike" /><h3>{t(lang, "join_pay_t")}</h3><p>{t(lang, "join_pay_text")}</p></li>
    </ul>

    {o.shifts.length > 0 && <>
      <h2>{t(lang, "join_shifts_h")}</h2>
      <p class="lead">{t(lang, "join_shifts_lead")}</p>
      <ul class="tiles">{o.shifts.map((s) => <li><Icon name="clock" /><h3>{shiftName(lang, s.id)} · <bdi dir="ltr">{s.from}–{s.to}</bdi></h3></li>)}</ul>
    </>}

    <h2>{t(lang, "join_who_h")}</h2>
    <ul class="ticks">
      {o.vehicles.length > 0 && <li><Icon name="check" /><span>{t(lang, "join_who_vehicle", { vehicles })}</span></li>}
      <li><Icon name="check" /><span>{t(lang, "join_who_licence")}</span></li>
      <li><Icon name="check" /><span>{t(lang, "join_who_hours")}</span></li>
      <li><Icon name="check" /><span>{t(lang, "join_who_number")}</span></li>
      <li><Icon name="check" /><span>{t(lang, "join_who_person")}</span></li>
    </ul>

    <h2>{t(lang, "join_cash_h")}</h2>
    <p>{t(lang, "join_cash_text", { soft: money(o.cash_cap.soft_usd), hard: money(o.cash_cap.hard_usd) })}</p>

    <h2>{t(lang, "join_terms_h")}</h2>
    <section class="ak-card">
      <p>{t(lang, "join_terms_text")}</p>
      <p>{t(lang, "join_terms_owed")}</p>
      <p><strong>{t(lang, "join_terms_rating")}</strong></p>
    </section>

    <h2 id="apply">{t(lang, "join_apply_h")}</h2>
    {applied
      ? <section class="ak-card" role="status"><h3><Icon name="check" /> {t(lang, "join_done_h")}</h3><p>{t(lang, "join_done_text")}</p></section>
      : !linked
        ? <ConfirmNumber lang={lang} purpose={PURPOSE} path={path} code={state?.code_waiting?.code ?? null} chat={chat} error={error || undefined} />
        : <>
            <p class="confirmed"><Icon name="check" /> {t(lang, "join_confirmed")}</p>
            <form method="post" action={path} class="stack">
              <input type="hidden" name="step" value="apply">
              {error && <p class="err" role="alert"><Icon name="alert" /> {error}</p>}
              <Field label={t(lang, "join_name")}><input class="ak-input" name="name" value={values.name} required maxlength="80" autocomplete="name"></Field>
              <Field label={t(lang, "join_village")}>
                <input class="ak-input" name="village" value={values.village} list="join-villages" required maxlength="60" autocomplete="off">
                <datalist id="join-villages">{o.villages.map((v) => <option value={villageText(lang, v)}></option>)}</datalist>
              </Field>
              <Field label={t(lang, "join_vehicle")}>
                <select class="ak-select" name="vehicle" required>
                  <option value="">{t(lang, "join_vehicle_choose")}</option>
                  {o.vehicles.map((v) => <option value={v} selected={v === values.vehicle}>{vehicleName(lang, v)}</option>)}
                </select>
              </Field>
              <fieldset class="checks"><legend>{t(lang, "join_licence")}</legend>
                <label><input type="radio" name="licence" value="yes" checked={values.licence === "yes"} required>{t(lang, "join_yes")}</label>
                <label><input type="radio" name="licence" value="no" checked={values.licence === "no"}>{t(lang, "join_no")}</label>
              </fieldset>
              <fieldset class="checks"><legend>{t(lang, "join_days")}</legend>
                {DAYS.map((d) => <label><input type="checkbox" name="days" value={d} checked={values.days.includes(d)}>{dayName(lang, d)}</label>)}
              </fieldset>
              <fieldset class="checks"><legend>{t(lang, "join_shifts")}</legend>
                {o.shifts.map((s) => <label><input type="checkbox" name="shifts" value={s.id} checked={values.shifts.includes(s.id)}>{shiftName(lang, s.id)} <bdi dir="ltr">{s.from}–{s.to}</bdi></label>)}
              </fieldset>
              <div class="actions"><Button label={t(lang, "join_submit")} variant="primary" size="lg" icon="check" /></div>
            </form>
          </>}
  </div>}
</Base>
