---
// WEB4b: a dish into the food basket (a form post, no script). The dish must be on the menu this visitor may see (web_food_menu, with the
// visitor's own session: a testers-only place answers only for a tester), and its required choices made: a missing one sends the visitor
// back to the dish with the choice named, before anything goes into the basket. A dish from a second place asks first whether to start a
// new basket (one place per food order, FD2); "Start a new basket" posts the same dish again with replace=1. Prices are never kept here.
import Base from "../../../layouts/Base.astro";
import Unavailable from "../../../components/Unavailable.astro";
import { SwitchQuestion, type SwitchView } from "../../../components/ref/Food";
import { t } from "../../../lib/i18n";
import { foodApi, orderHref } from "../../../lib/food";
import { addLine, basketCookie, basketOf, checkChoices, isUuid } from "../../../lib/food-basket";
import { seeOther, visitorOf } from "../../../lib/order";
import { sameOrigin } from "../../../lib/session";
const { lang, env } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");
if (Astro.request.method !== "POST") return seeOther("/food/basket");
if (!sameOrigin(Astro.request, Astro.url)) return new Response("Forbidden", { status: 403, headers: { "Content-Type": "text/plain; charset=utf-8" } });
const cookie = Astro.request.headers.get("cookie");
const form = await Astro.request.formData();
const get = (k: string) => { const x = form.get(k); return typeof x === "string" ? x : ""; };
const place = get("place"); const dishId = get("dish");
const qty = Math.min(50, Math.max(1, Math.round(Number(get("qty")) || 1)));
// the choices: a radio per single-choice group (g:<group> = option), a box per option of a several-choice group (g:<group>:<option>), or
// the plain opt fields the "new basket?" question posts back
const chosen: string[] = [];
for (const [k, v] of form.entries()) {
  if (typeof v !== "string" || !v) continue;
  if ((k === "opt" || /^g:[0-9a-f-]{36}(?::[0-9a-f-]{36})?$/.test(k)) && isUuid(v) && !chosen.includes(v)) chosen.push(v);
}
const replace = get("replace") === "1";
let failed = false; let notFound = false; let question: SwitchView | null = null;
try {
  if (!isUuid(place) || !isUuid(dishId)) notFound = true;
  else {
    const v = await visitorOf(env, cookie);
    const api = foodApi(env);
    const menu = await api.menu(v.token, place);
    const dish = menu.ok ? (menu.dishes ?? []).find((d) => d.product_id === dishId) : null;
    if (!menu.ok) notFound = true;
    else if (!dish) return seeOther(orderHref(place));
    else {
      const ok = checkChoices(dish, chosen);
      if (!ok.ok) return seeOther(`${orderHref(place)}?need=${dishId}${ok.why === "need" ? `&g=${ok.group}` : ""}#dish-${dishId}`);
      const basket = basketOf(cookie);
      if (basket && basket.place !== place && !replace) {
        const places = await api.places(v.token);
        const old = places.find((p) => p.source_id === basket.place);
        if (old) {
          question = { lang, oldName: old.name, newName: menu.name ?? "", fields: [["place", place], ["dish", dishId], ["qty", String(qty)], ...chosen.map((o) => ["opt", o] as [string, string])] };
        }
      }
      if (!question) {
        const next = addLine(replace || (basket && basket.place !== place) ? null : basket, place, { product_id: dishId, qty, options: chosen });
        if (!next) return seeOther("/food/basket?full=1");
        return seeOther(`${orderHref(place)}?added=1#dish-${dishId}`, basketCookie(next));
      }
    }
  }
} catch { failed = true; Astro.response.status = 503; }
if (notFound) Astro.response.status = 404;
if (question) Astro.response.status = 409;
---
<Base title={question ? t(lang, "w4b_switch_title") : t(lang, "not_found")} lang={lang} path="/food/basket" noindex bare={!!question}>
  {failed ? <Unavailable lang={lang} /> : question ? <SwitchQuestion v={question} /> : <Unavailable lang={lang} notFound />}
</Base>
