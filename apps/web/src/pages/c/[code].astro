---
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import Unavailable from "../../components/Unavailable.astro";
import { nameIn, t } from "../../lib/i18n";
const { lang, catalog, env } = Astro.locals;
let r; let failed = false;
const code = String(Astro.params.code ?? "");
// A code is letters, digits, underscore and hyphen: anything else is not a category, and never reaches the database.
try { r = /^[a-z0-9_-]{1,60}$/i.test(code) ? await catalog().category(code) : { ok: false as const, error: "unknown_category" as const }; } catch { failed = true; Astro.response.status = 503; }
if (r && !r.ok) Astro.response.status = 404;
const sections = r && r.ok ? r.sections : [];
const count = sections.reduce((a, s) => a + s.items.length, 0);
const anyCredit = sections.some((s) => s.items.some((i) => i.picture?.licence === "cc_by_sa"));
const title = r && r.ok ? nameIn(lang, r.category.name_en, r.category.name_ar) : t(lang, "not_found");
---
<Base title={title} lang={lang} path={Astro.url.pathname}>
  {failed ? <Unavailable lang={lang} /> : !r || !r.ok ? <Unavailable lang={lang} notFound /> : <>
    <h1>{title}</h1>
    <p class="muted">{t(lang, "items", { n: count })}</p>
    {sections.map((s) => (
      <section>
        {(s.title_en || s.title_ar) && <h2 class="sec-title">{nameIn(lang, s.title_en, s.title_ar)}</h2>}
        <ul class="grid">{s.items.map((item) => <Card item={item} lang={lang} env={env} />)}</ul>
      </section>
    ))}
    {anyCredit && <p class="muted small credit">{t(lang, "credit_pictures")}</p>}
  </>}
</Base>
