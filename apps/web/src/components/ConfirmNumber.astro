---
// Step one of both join pages (session UX3): "Confirm your number on WhatsApp", the WEB2 way (docs/WEBSITE.md, "Identity and consent"). The visitor gets a code, sends
// it to our customer number, and the customer-line turn links the number to this session by code. There is no number to type: we never message a number that has not
// messaged us (invariant 17). Without a script: a button, a link, and a link back to this page.
import Button from "@ak/ui-astro/Button.astro";
import Icon from "@ak/ui-astro/Icon.astro";
import { t, type Lang } from "../lib/i18n";
interface Props { lang: Lang; purpose: "rider" | "vendor"; path: string; code?: string | null; chat?: string | null; error?: string }
const { lang, purpose, path, code = null, chat = null, error } = Astro.props;
---
<section class="ak-card confirm" id="confirm" aria-labelledby="confirm-h">
  <h3 id="confirm-h">{t(lang, "join_confirm_h")}</h3>
  <p>{t(lang, purpose === "rider" ? "join_confirm_rider" : "join_confirm_vendor")}</p>
  {error && <p class="err" role="alert"><Icon name="alert" /> {error}</p>}
  {code
    ? <>
        <p class="muted small">{t(lang, "join_code_h")}</p>
        <p class="code" dir="ltr"><bdi>{code}</bdi></p>
        {chat ? <div class="actions"><Button label={t(lang, "join_code_send")} href={`${chat}?text=${code}`} variant="whatsapp" icon="chat" external /></div> : <p>{t(lang, "join_code_plain", { code })}</p>}
        <p class="muted small">{t(lang, "join_code_note")}</p>
        <div class="actions">
          <Button label={t(lang, "join_code_check")} href={`${path}#apply`} variant="soft" icon="refresh" />
          <form method="post" action={path}><input type="hidden" name="step" value="code"><Button label={t(lang, "join_code_new")} variant="ghost" /></form>
        </div>
      </>
    : <form method="post" action={path}><input type="hidden" name="step" value="code"><Button label={t(lang, "join_confirm_get")} variant="primary" icon="chat" /></form>}
</section>
