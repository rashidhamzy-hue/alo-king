{
  "name": "rebuild/lebanon: CI must pass",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["refs/heads/rebuild/lebanon"], "exclude": [] }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "what changed", "integration_id": 15368 },
          { "context": "install, typecheck, lint, test, build", "integration_id": 15368 },
          {
            "context": "website quality (Lighthouse, axe, screenshots; DECISIONS §37.5)",
            "integration_id": 15368
          },
          { "context": "secret-scan", "integration_id": 15368 },
          { "context": "data freeze (DECISIONS §31)", "integration_id": 15368 },
          { "context": "migration guard and dry-run against staging", "integration_id": 15368 },
          {
            "context": "migrations and RLS tests on a throwaway Supabase Postgres",
            "integration_id": 15368
          },
          { "context": "Claude review", "integration_id": 15368 }
        ]
      }
    }
  ]
}
