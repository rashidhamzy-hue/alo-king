{
  "name": "alo-king-gateway",
  "main": "apps/gateway/src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "durable_objects": { "bindings": [{ "name": "CONVERSATION", "class_name": "ConversationDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversationDO"] }],
  "queues": {
    "producers": [{ "binding": "INBOUND", "queue": "ak-inbound" }],
    "consumers": [{ "queue": "ak-inbound", "max_batch_size": 10, "max_batch_timeout": 0, "max_retries": 5, "dead_letter_queue": "ak-inbound-dlq" }]
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "KAPSO_BASE_URL": "https://api.kapso.ai/meta/whatsapp/v24.0",
    "MODEL_FAST": "claude-haiku-5-5",
    "MODEL_SMART": "claude-sonnet-5-5",
    "BUFFER_SECONDS": "6"
  },
  // Two deployments that share nothing. `wrangler deploy --env staging` and `--env production`.
  // Bindings and vars are not inherited by environments, so each block is complete on purpose.
  "env": {
    "staging": {
      "name": "alo-king-gateway-staging",
      "durable_objects": { "bindings": [{ "name": "CONVERSATION", "class_name": "ConversationDO" }] },
      "queues": {
        "producers": [{ "binding": "INBOUND", "queue": "ak-inbound-staging" }],
        "consumers": [{ "queue": "ak-inbound-staging", "max_batch_size": 10, "max_batch_timeout": 0, "max_retries": 5, "dead_letter_queue": "ak-inbound-staging-dlq" }]
      },
      "triggers": { "crons": ["* * * * *"] },
      "vars": { "KAPSO_BASE_URL": "https://api.kapso.ai/meta/whatsapp/v24.0", "MODEL_FAST": "claude-haiku-5-5", "MODEL_SMART": "claude-sonnet-5-5", "BUFFER_SECONDS": "6", "ENVIRONMENT": "staging", "WABA_ID_CUSTOMER": "1086076707594153", "PROBE_MODE": "on", "SENTRY_DSN": "https://a8adb1e4ba4769f28df5e5dc24d7576f@o4512423714488320.ingest.de.sentry.io/4512423723728976" }
    },
    "production": {
      "name": "alo-king-gateway",
      "durable_objects": { "bindings": [{ "name": "CONVERSATION", "class_name": "ConversationDO" }] },
      "queues": {
        "producers": [{ "binding": "INBOUND", "queue": "ak-inbound" }],
        "consumers": [{ "queue": "ak-inbound", "max_batch_size": 10, "max_batch_timeout": 0, "max_retries": 5, "dead_letter_queue": "ak-inbound-dlq" }]
      },
      "triggers": { "crons": ["* * * * *"] },
      "vars": { "KAPSO_BASE_URL": "https://api.kapso.ai/meta/whatsapp/v24.0", "MODEL_FAST": "claude-haiku-5-5", "MODEL_SMART": "claude-sonnet-5-5", "BUFFER_SECONDS": "6", "ENVIRONMENT": "production" }
    }
  }
  // SENTRY_DSN is a public client key (it can only send events), so it lives in vars, not secrets. Org "alo-king" (EU, de.sentry.io), project alo-king-gateway;
  // the earlier DSN belonged to another organization whose error quota was used up (events dropped as rate_limited). Production gets its own project at 4.2.
  // PROBE_MODE "on" (staging only) lets the cron run the hourly test order (4.10). Production must never set it.
  // Secrets, per environment (wrangler secret put NAME --env staging): KAPSO_API_KEY, KAPSO_WEBHOOK_SECRET_CUSTOMER, KAPSO_WEBHOOK_SECRET_OPS, KAPSO_WEBHOOK_SECRET_PROJECT,
  // PHONE_NUMBER_ID_CUSTOMER, PHONE_NUMBER_ID_OPS, SUPABASE_URL, SUPABASE_SERVICE_KEY, ANTHROPIC_API_KEY, STT_API_KEY
}
